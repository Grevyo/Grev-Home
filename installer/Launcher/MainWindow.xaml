<Window x:Class="GrevHome.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grev Home Setup" Width="1180" Height="720"
        MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource UiFont}" Foreground="#F7F8FF"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00D9FF" Offset="0"/>
            <GradientStop Color="#2878FF" Offset="0.52"/>
            <GradientStop Color="#A94DFF" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="27,13"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.86"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="White"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#1B2238"/><Setter Property="Padding" Value="23,12"/>
        </Style>
        <Style x:Key="Choice" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F4F6FF"/><Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Card" CornerRadius="15" Background="#151B2D" BorderBrush="#2A334D" BorderThickness="1" Padding="18,16">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><ContentPresenter/><TextBlock Text="{TemplateBinding Tag}" Foreground="#94A0BC" FontSize="12" FontWeight="Normal" Margin="0,5,15,0" TextWrapping="Wrap"/></StackPanel>
                            <Border x:Name="Tick" Grid.Column="1" Width="28" Height="28" CornerRadius="9" BorderBrush="#52607B" BorderThickness="1.5" Background="#0C1120">
                                <TextBlock x:Name="TickGlyph" Text="✓" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#29CCFF"/><Setter TargetName="Card" Property="Background" Value="#172442"/><Setter TargetName="Tick" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="TickGlyph" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#6E7EA5"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="White"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FolderCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F5F7FF"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card" CornerRadius="14" Background="#151B2D" BorderBrush="#2A334D" BorderThickness="1" Padding="17,14">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border x:Name="DotRing" Width="20" Height="20" CornerRadius="10" BorderBrush="#65718B" BorderThickness="2" HorizontalAlignment="Left"><Ellipse x:Name="Dot" Width="10" Height="10" Fill="#21D3FF" Opacity="0"/></Border>
                            <StackPanel Grid.Column="1"><ContentPresenter/><TextBlock Text="{TemplateBinding Tag}" Foreground="#92A0BC" FontSize="12" FontWeight="Normal" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#28D0FF"/><Setter TargetName="Card" Property="Background" Value="#172442"/><Setter TargetName="Dot" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="White"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="26" Background="#090D18" BorderBrush="#34405C" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.55" Color="#000000"/></Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="AmbientPurple" Width="540" Height="540" Canvas.Left="690" Canvas.Top="-260" Opacity="0.17" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#8F36FF"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse x:Name="AmbientCyan" Width="440" Height="440" Canvas.Left="260" Canvas.Top="470" Opacity="0.14" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#00DFFF"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="65"/></Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <Border Grid.Column="0" Background="#B20D1221" CornerRadius="26,0,0,26" BorderBrush="#26304A" BorderThickness="0,0,1,0">
                <Grid Margin="27,28,27,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/GrevMark.png" Width="52" Height="52" Stretch="Uniform"/>
                        <StackPanel Margin="12,6,0,0"><TextBlock Text="GREV HOME" FontSize="16" FontWeight="Bold"/><TextBlock Text="SETUP  ·  0.16" Foreground="#66DFFF" FontSize="10" FontWeight="SemiBold"/></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="YOUR SETUP" Foreground="#74809B" FontWeight="Bold" FontSize="10" Margin="3,0,0,14"/>
                        <TextBlock x:Name="Step1" Text="01  Welcome" FontSize="14" Margin="3,9" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="Step2" Text="02  What you play" FontSize="14" Margin="3,9" Foreground="#65718C"/>
                        <TextBlock x:Name="Step3" Text="03  Your systems" FontSize="14" Margin="3,9" Foreground="#65718C"/>
                        <TextBlock x:Name="Step4" Text="04  Folders" FontSize="14" Margin="3,9" Foreground="#65718C"/>
                        <TextBlock x:Name="Step5" Text="05  Install" FontSize="14" Margin="3,9" Foreground="#65718C"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="10,7">
                        <Image Source="Assets/GrevCo.jpeg" Height="38" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/><RowDefinition Height="78"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,14,0">
                        <Button Content="—" Width="40" Height="34" Background="Transparent" Foreground="#AAB3C8" BorderThickness="0" FontSize="17" Click="Minimize_Click"/>
                        <Button Content="×" Width="40" Height="34" Background="Transparent" Foreground="#AAB3C8" BorderThickness="0" FontSize="20" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PageHost" Grid.Row="1" Margin="58,15,58,0">
                    <Grid x:Name="WelcomePage">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Border Background="#15213C" CornerRadius="10" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,17"><TextBlock Text="A HOME FOR HOW YOU PLAY" Foreground="#64DEFF" FontSize="10" FontWeight="Bold"/></Border>
                            <TextBlock Text="Make this PC&#x0a;feel like yours." FontSize="48" FontWeight="Bold" LineHeight="52"/>
                            <TextBlock Text="Choose what belongs in your setup. Grev Home will prepare the right folders and keep your games, apps and emulators together." Foreground="#A5AFC5" FontSize="15" TextWrapping="Wrap" LineHeight="24" Margin="0,18,12,0"/>
                            <TextBlock Text="Mouse  ·  Keyboard  ·  Controller" Foreground="#6CE2FF" FontSize="12" Margin="0,26,0,0"/>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Ellipse Width="310" Height="310" Fill="#101A33"><Ellipse.Effect><BlurEffect Radius="2"/></Ellipse.Effect></Ellipse>
                            <Image x:Name="HeroMark" Source="Assets/GrevMark.png" Width="310" Height="310" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform><TransformGroup><ScaleTransform x:Name="HeroScale" ScaleX="1" ScaleY="1"/><RotateTransform x:Name="HeroRotate" Angle="-2"/></TransformGroup></Image.RenderTransform>
                            </Image>
                        </Grid>
                    </Grid>

                    <Grid x:Name="IntentPage" Visibility="Collapsed">
                        <StackPanel><TextBlock Text="What belongs in your Grev Home?" FontSize="34" FontWeight="Bold"/><TextBlock Text="Pick one, two, or all three. You can change this later." Foreground="#99A5BD" FontSize="14" Margin="0,7,0,23"/>
                            <CheckBox x:Name="PcGamesCheck" Content="PC games" Tag="Bring together games installed on this PC." Style="{StaticResource Choice}" IsChecked="True"/>
                            <CheckBox x:Name="AppsCheck" Content="Apps" Tag="Keep launchers, media and everyday apps close by." Style="{StaticResource Choice}" IsChecked="True"/>
                            <CheckBox x:Name="EmulatorsCheck" Content="Emulators and console games" Tag="Prepare game and BIOS locations for the systems you choose." Style="{StaticResource Choice}" IsChecked="True"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ConsolesPage" Visibility="Collapsed">
                        <StackPanel><TextBlock Text="Which systems are part of your setup?" FontSize="32" FontWeight="Bold"/><TextBlock Text="This prepares your folders. BIOS and firmware must come from hardware you own." Foreground="#99A5BD" FontSize="14" Margin="0,7,0,20"/>
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="Ps1Check" Content="PlayStation" Tag="PS1" Style="{StaticResource Choice}" Margin="0,0,8,10"/>
                                <CheckBox x:Name="Ps2Check" Content="PlayStation 2" Tag="PS2" Style="{StaticResource Choice}" Margin="8,0,0,10" IsChecked="True"/>
                                <CheckBox x:Name="Ps3Check" Content="PlayStation 3" Tag="PS3" Style="{StaticResource Choice}" Margin="0,0,8,10"/>
                                <CheckBox x:Name="DsCheck" Content="Nintendo DS" Tag="Nintendo" Style="{StaticResource Choice}" Margin="8,0,0,10"/>
                                <CheckBox x:Name="SwitchCheck" Content="Nintendo Switch" Tag="Nintendo" Style="{StaticResource Choice}" Margin="0,0,8,10"/>
                                <CheckBox x:Name="ThreeDsCheck" Content="Nintendo 3DS" Tag="Nintendo" Style="{StaticResource Choice}" Margin="8,0,0,10"/>
                                <CheckBox x:Name="XboxCheck" Content="Original Xbox" Tag="Microsoft" Style="{StaticResource Choice}" Margin="0,0,8,10"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="FoldersPage" Visibility="Collapsed">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Games folder" FontSize="25" FontWeight="Bold"/><TextBlock Text="Where should Grev Home look?" Foreground="#99A5BD" Margin="0,5,0,17"/>
                                <RadioButton x:Name="GamesStandard" GroupName="Games" Content="Use the Grev Home standard" Tag="C:\GrevCo\GrevHome\Games" Style="{StaticResource FolderCard}" IsChecked="True" Checked="FolderChoice_Changed"/>
                                <RadioButton x:Name="GamesExisting" GroupName="Games" Content="Use my existing Games folder" Tag="Browse to directory" Style="{StaticResource FolderCard}" Checked="FolderChoice_Changed"/>
                                <Button x:Name="BrowseGamesButton" Content="Browse for Games folder" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="BrowseGames_Click" Visibility="Collapsed"/>
                                <TextBlock x:Name="GamesPathText" Text="C:\GrevCo\GrevHome\Games" Foreground="#69DBFF" FontSize="11" TextWrapping="Wrap" Margin="2,11,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="BIOS folder" FontSize="25" FontWeight="Bold"/><TextBlock Text="Only needed for selected emulators." Foreground="#99A5BD" Margin="0,5,0,17"/>
                                <RadioButton x:Name="BiosStandard" GroupName="Bios" Content="Use the Grev Home standard" Tag="C:\GrevCo\GrevHome\bios" Style="{StaticResource FolderCard}" IsChecked="True" Checked="FolderChoice_Changed"/>
                                <RadioButton x:Name="BiosExisting" GroupName="Bios" Content="Use my existing BIOS folder" Tag="Browse to directory" Style="{StaticResource FolderCard}" Checked="FolderChoice_Changed"/>
                                <Button x:Name="BrowseBiosButton" Content="Browse for BIOS folder" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="BrowseBios_Click" Visibility="Collapsed"/>
                                <TextBlock x:Name="BiosPathText" Text="C:\GrevCo\GrevHome\bios" Foreground="#69DBFF" FontSize="11" TextWrapping="Wrap" Margin="2,11,0,0"/>
                                <Border Background="#141C30" CornerRadius="10" Padding="11" Margin="0,16,0,0"><TextBlock Text="Grev Home never downloads copyrighted BIOS or firmware files." Foreground="#AEB8CD" FontSize="11" TextWrapping="Wrap"/></Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ReadyPage" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" MaxWidth="690"><TextBlock Text="Ready to build your Grev Home." FontSize="37" FontWeight="Bold" TextAlignment="Center"/><TextBlock Text="Your choices are set. The reliable Grev Home setup engine will handle installation and upgrades in the background." Foreground="#9FAAC0" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" Margin="35,12,35,26"/>
                            <Border Background="#151B2D" BorderBrush="#2B3651" BorderThickness="1" CornerRadius="17" Padding="22">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="INSTALL LOCATION" Foreground="#6DDFFF" FontSize="10" FontWeight="Bold"/><TextBlock Text="C:\GrevCo\GrevHome" Margin="0,7,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="SELECTED" Foreground="#6DDFFF" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ReadySelectionText" Text="PC games · Apps · Emulators" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="InstallPage" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="640">
                            <Grid Width="180" Height="180"><Ellipse Fill="#101B35"/><Image Source="Assets/GrevMark.png" Stretch="Uniform"/></Grid>
                            <TextBlock x:Name="InstallTitle" Text="Creating your Grev Home…" FontSize="31" FontWeight="Bold" TextAlignment="Center" Margin="0,18,0,7"/>
                            <TextBlock x:Name="InstallStatus" Text="Preparing setup" Foreground="#9EA9BF" FontSize="14" TextAlignment="Center"/>
                            <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Value="2" Margin="0,25,0,0" Foreground="#25D6FF" Background="#182039" BorderThickness="0"/>
                            <TextBlock x:Name="InstallPercent" Text="2%" Foreground="#6DDBFF" HorizontalAlignment="Right" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="NavigationBar" Grid.Row="2" Margin="58,8,58,15">
                    <Button x:Name="BackButton" Content="Back" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="Back_Click" Visibility="Collapsed"/>
                    <TextBlock x:Name="ControllerHint" Text="D-pad  Navigate    A  Select    B  Back" Foreground="#64708B" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Button x:Name="NextButton" Content="Get started" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Next_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
