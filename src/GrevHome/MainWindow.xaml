<Window x:Class="GrevHome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grev Home"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="#090C12"
        Foreground="White"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.45,0.25" GradientOrigin="0.45,0.25" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#182137" Offset="0" />
                <GradientStop Color="#090C12" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#D90B0F17"
                BorderBrush="#263044"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ShellBackButton"
                        Grid.Column="0"
                        Content="← Back"
                        Width="112"
                        Height="48"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Click="ShellBack_Click" />

                <TextBlock Grid.Column="1"
                           Text="GREV HOME"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#C9D3E8" />

                <Button x:Name="ProfileBubbleButton"
                        Grid.Column="3"
                        Visibility="Collapsed"
                        MinWidth="260"
                        MaxWidth="620"
                        Height="52"
                        Margin="14,0,10,0"
                        Padding="16,8"
                        VerticalAlignment="Center"
                        Click="ShellProfile_Click">
                    <TextBlock x:Name="ControllerStatusText"
                               Text="No signed-in players"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </Button>

                <Button x:Name="ShellSettingsButton"
                        Grid.Column="4"
                        Content="⚙ Settings"
                        Width="132"
                        Height="48"
                        VerticalAlignment="Center"
                        Click="ShellSettings_Click" />
            </Grid>
        </Border>

        <ContentControl x:Name="RouteHost" Grid.Row="1" Focusable="False" />

        <Grid Grid.Row="2" Margin="34,0">
            <TextBlock Text="A / Enter  Select     B / Esc  Back"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="Hold LB + RB + View to return to Grev Home"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}" />
        </Grid>
    </Grid>
</Window>
