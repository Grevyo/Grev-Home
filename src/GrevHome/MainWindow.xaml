<Window x:Class="GrevHome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grev Home"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="#090C12"
        Foreground="White"
        Loaded="Window_HeaderNavigationLoaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid KeyboardNavigation.DirectionalNavigation="Continue">
        <Grid.Background>
            <RadialGradientBrush Center="0.45,0.25" GradientOrigin="0.45,0.25" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#182137" Offset="0" />
                <GradientStop Color="#090C12" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Grid x:Name="ShellInteractionHost" KeyboardNavigation.DirectionalNavigation="Continue">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#D90B0F17"
                    BorderBrush="#263044"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,0" KeyboardNavigation.DirectionalNavigation="Continue">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ShellBackButton"
                            Grid.Column="0"
                            Content="← Back"
                            Width="112"
                            Height="48"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            Click="ShellBack_Click" />

                    <TextBlock Grid.Column="1"
                               Text="GREV HOME"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#C9D3E8" />

                    <Button x:Name="ProfileBubbleButton"
                            Grid.Column="3"
                            Visibility="Collapsed"
                            MinWidth="220"
                            MaxWidth="820"
                            Height="56"
                            Margin="14,0,10,0"
                            Padding="10,5"
                            HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Center"
                            Click="ShellProfileMenu_Click">
                        <StackPanel x:Name="HeaderPlayersPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center" />
                    </Button>

                    <Button x:Name="ShellSettingsButton"
                            Grid.Column="4"
                            Content="⚙ Settings"
                            Width="132"
                            Height="48"
                            VerticalAlignment="Center"
                            Click="ShellSettings_Click" />

                    <Button x:Name="ShellPowerButton"
                            Grid.Column="5"
                            Content="⏻"
                            Width="62"
                            Height="Auto"
                            MinHeight="50"
                            Margin="10,0,0,0"
                            Padding="8"
                            VerticalAlignment="Center"
                            FontSize="20"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="ShellPower_Click" />
                </Grid>
            </Border>

            <ContentControl x:Name="RouteHost"
                            Grid.Row="1"
                            Focusable="False"
                            KeyboardNavigation.DirectionalNavigation="Continue" />

            <Grid Grid.Row="2" Margin="34,0">
                <TextBlock Text="A / Enter  Select     B / Esc  Back"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="Hold LB + RB + View to return to Grev Home"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </Grid>

        <Border x:Name="PowerMenuOverlay"
                Visibility="Collapsed"
                Background="#88090C12"
                Panel.ZIndex="90">
            <Grid>
                <Border Width="430"
                        Margin="0,76,28,0"
                        Padding="22"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#11151E"
                        BorderBrush="#3A465F"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Border.Resources>
                        <Style x:Key="PowerMenuButtonStyle"
                               TargetType="Button"
                               BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Height" Value="Auto" />
                            <Setter Property="MinHeight" Value="52" />
                            <Setter Property="Padding" Value="16,10" />
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>

                    <StackPanel>
                        <TextBlock Text="POWER &amp; SYSTEM"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="PowerMenuStatusText"
                                   Text="Select an action. Power actions require a second press to confirm."
                                   Margin="0,7,0,14"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />

                        <Button x:Name="PowerAppKillerButton"
                                Content="App Killer"
                                Margin="0,0,0,7"
                                Style="{StaticResource PowerMenuButtonStyle}"
                                Click="PowerAppKiller_Click" />
                        <Button x:Name="PowerRunningAppsButton"
                                Content="Running Apps"
                                Margin="0,0,0,14"
                                Style="{StaticResource PowerMenuButtonStyle}"
                                Click="PowerRunningApps_Click" />

                        <Border Height="1" Background="#2B3344" Margin="0,0,0,14" />

                        <Button x:Name="PowerSleepButton"
                                Content="Sleep"
                                Margin="0,0,0,7"
                                Style="{StaticResource PowerMenuButtonStyle}"
                                Click="PowerSleep_Click" />
                        <Button x:Name="PowerRestartButton"
                                Content="Restart"
                                Margin="0,0,0,7"
                                Style="{StaticResource PowerMenuButtonStyle}"
                                Click="PowerRestart_Click" />
                        <Button x:Name="PowerShutdownButton"
                                Content="Shut Down"
                                Margin="0,0,0,7"
                                Style="{StaticResource PowerMenuButtonStyle}"
                                Click="PowerShutdown_Click" />
                        <Button x:Name="PowerCloseGrevHomeButton"
                                Content="Close Grev Home"
                                Margin="0,0,0,14"
                                Style="{StaticResource PowerMenuButtonStyle}"
                                Click="PowerCloseGrevHome_Click" />

                        <Button x:Name="PowerMenuCancelButton"
                                Content="Cancel"
                                Style="{StaticResource PowerMenuButtonStyle}"
                                Click="PowerMenuCancel_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="StoreModalOverlay"
                Visibility="Collapsed"
                Background="#E6090C12"
                Panel.ZIndex="100">
            <Grid>
                <Border MinWidth="560"
                        MaxWidth="820"
                        MaxHeight="720"
                        Margin="36"
                        Style="{StaticResource ShellModalCardStyle}">
                    <Grid KeyboardNavigation.DirectionalNavigation="Contained">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="StoreModalTitleText"
                                   Grid.Row="0"
                                   Text="Grev Store"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />

                        <Grid Grid.Row="1" Margin="0,22,0,0">
                            <!-- Progress text can grow or wrap without forcing the whole modal off-screen. -->
                            <ScrollViewer Visibility="{Binding Visibility, ElementName=StoreProgressPanel}"
                                          MaxHeight="500"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="StoreProgressPanel">
                                    <TextBlock x:Name="StoreProgressStageText"
                                               Text="Preparing"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" />
                                    <ProgressBar x:Name="StoreProgressBar"
                                                 Height="24"
                                                 Margin="0,16,0,0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0" />
                                    <TextBlock x:Name="StoreProgressPercentText"
                                               Text="0%"
                                               Margin="0,8,0,0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="StoreProgressMessageText"
                                               Text="Preparing operation…"
                                               Margin="0,14,0,0"
                                               FontSize="16"
                                               Foreground="#D7DCE7"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                    <TextBlock Text="Grev Home is locked until this operation finishes. Do not close the app or interrupt the process."
                                               Margin="0,16,0,0"
                                               FontSize="13"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Warning information scrolls independently; its action footer never moves. -->
                            <ScrollViewer Visibility="{Binding Visibility, ElementName=StoreWarningPanel}"
                                          MaxHeight="430"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="StoreWarningPanel" Visibility="Collapsed">
                                    <TextBlock Text="All data associated with this app can be lost by performing this action. Make sure anything you want to keep is backed up before continuing."
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                    <TextBlock Text="Grev Home preserves profile-owned data where this package supports it, but a backup is the only safe guarantee."
                                               Margin="0,14,0,0"
                                               FontSize="14"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <Border Grid.Row="2"
                                Margin="0,20,0,0"
                                Padding="0,14,0,0"
                                BorderBrush="#2B3344"
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding Visibility, ElementName=StoreWarningPanel}">
                            <WrapPanel HorizontalAlignment="Center">
                                <Button x:Name="StoreWarningCancelButton"
                                        Content="Cancel"
                                        Style="{StaticResource ShellModalActionButtonStyle}"
                                        Click="StoreWarningCancel_Click" />
                                <Button Content="UNINSTALL ANYWAY"
                                        MinWidth="220"
                                        Style="{StaticResource ShellModalDangerActionButtonStyle}"
                                        Click="StoreWarningConfirm_Click" />
                            </WrapPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
