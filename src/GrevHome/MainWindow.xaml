<Window x:Class="GrevHome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grev Home"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="#090C12"
        Foreground="White"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.45,0.25" GradientOrigin="0.45,0.25" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#182137" Offset="0" />
                <GradientStop Color="#090C12" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="34,0">
            <TextBlock Text="GREV HOME"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#C9D3E8" />
            <TextBlock x:Name="ControllerStatusText"
                       Text="No controllers"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="{StaticResource MutedBrush}" />
        </Grid>

        <ContentControl x:Name="RouteHost" Grid.Row="1" Focusable="False" />

        <Grid Grid.Row="2" Margin="34,0">
            <TextBlock Text="A / Enter  Select     B / Esc  Back"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="Hold LB + RB + View to return to Grev Home"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}" />
        </Grid>
    </Grid>
</Window>
