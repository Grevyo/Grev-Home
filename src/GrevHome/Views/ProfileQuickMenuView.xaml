<UserControl x:Class="GrevHome.Views.ProfileQuickMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="ProfileQuickActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileQuickControllerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ProfileQuickActionButtonStyle}">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </UserControl.Resources>

    <Grid KeyboardNavigation.DirectionalNavigation="Contained">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="WHO'S PLAYING"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBlock x:Name="SummaryText"
                       Margin="0,5,0,0"
                       FontSize="15"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      MaxHeight="500"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <StackPanel x:Name="PlayersPanel" />
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="0,14,0,0"
                BorderBrush="#2B3344"
                BorderThickness="0,1,0,0">
            <WrapPanel>
                <Button x:Name="AddPlayerButton"
                        Content="Add Player"
                        Style="{StaticResource ProfileQuickActionButtonStyle}"
                        Click="AddPlayer_Click" />
                <Button x:Name="ManagePlayersButton"
                        Content="Manage Players"
                        MinWidth="142"
                        Style="{StaticResource ProfileQuickActionButtonStyle}"
                        Click="ManagePlayers_Click" />
                <Button x:Name="CloseButton"
                        Content="Close"
                        Style="{StaticResource ProfileQuickActionButtonStyle}"
                        Click="Close_Click" />
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
