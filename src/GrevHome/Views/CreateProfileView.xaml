<UserControl x:Class="GrevHome.Views.CreateProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GrevHome.Views"
             Focusable="False">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
            <StackPanel x:Name="AccountDetailsStep" Margin="72,42" HorizontalAlignment="Center" Width="900">
                <TextBlock Text="Create account"
                           HorizontalAlignment="Center"
                           FontSize="42"
                           FontWeight="SemiBold" />
                <TextBlock Text="Choose the permanent username, then assign the account's Grev Home role."
                           HorizontalAlignment="Center"
                           Margin="0,8,0,24"
                           FontSize="16"
                           Foreground="{DynamicResource MutedBrush}" />

                <TextBlock Text="USERNAME • PERMANENT • UP TO 50 CHARACTERS" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                <Grid Margin="0,7,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ProfileNameTextBox"
                             Height="56"
                             Padding="14,8"
                             FontSize="22"
                             MaxLength="50"
                             IsReadOnly="True"
                             IsTabStop="False" />
                    <Button x:Name="OpenKeyboardButton" Grid.Column="1"
                            Content="Open Keyboard"
                            Width="180"
                            Height="56"
                            Margin="10,0,0,0"
                            Click="OpenKeyboard_Click" />
                </Grid>

                <TextBlock Text="ACCOUNT ROLE" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,8" />
                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Button x:Name="AdminRoleButton" Content="Admin" Tag="Admin" Width="210" Height="58" Margin="5" Click="Role_Click" />
                    <Button x:Name="StandardRoleButton" Content="Standard" Tag="Standard" Width="210" Height="58" Margin="5" Click="Role_Click" />
                    <Button x:Name="GuestRoleButton" Content="Guest" Tag="Guest" Width="210" Height="58" Margin="5" Click="Role_Click" />
                </WrapPanel>
                <TextBlock x:Name="RoleDescriptionText"
                           Text="Admin • full Grev Home access."
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="StatusText"
                           Text="Display Name starts the same as Username and can be changed later without changing GrevID or folders."
                           Margin="0,0,0,20"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="CreateAccountButton" Content="Create offline account" MinWidth="250" Height="56" Margin="6" Click="Create_Click" />
                    <Button x:Name="CreateLinkedAccountButton" Content="Create + link Grev.dad" MinWidth="250" Height="56" Margin="6" Click="CreateLinked_Click" />
                    <Button Content="Cancel" Width="150" Height="56" Margin="6" Click="Cancel_Click" />
                </StackPanel>
                <TextBlock x:Name="AccountTypeHintText"
                           Text="Offline accounts never need the internet. Link Grev.dad now or later from Edit Profile to restore your level, achievements, friends and cloud saves on any PC."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,14,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="GrevDadLinkStep" Margin="72,42" HorizontalAlignment="Center" Width="900" Visibility="Collapsed">
                <TextBlock Text="Connect Grev.dad" HorizontalAlignment="Center" FontSize="42" FontWeight="SemiBold" />
                <TextBlock Text="Approve this PC on your Grev.dad account. Grev Home finishes automatically as soon as you approve."
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,24" FontSize="16"
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                <Border Padding="22" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="GrevDadCodeText" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" />
                        <TextBlock x:Name="GrevDadInstructionsText" FontSize="17" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,14" />
                        <WrapPanel HorizontalAlignment="Center">
                            <Button x:Name="OpenGrevDadApprovalButton" Content="Approve in Grev Home browser" MinWidth="300" Height="56" Margin="5" Visibility="Collapsed" Click="OpenGrevDadApproval_Click" />
                            <Button x:Name="NewGrevDadCodeButton" Content="Get a new code" MinWidth="220" Height="56" Margin="5" Visibility="Collapsed" Click="NewGrevDadCode_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="GrevDadOnboardingStatus" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button x:Name="FinishGrevDadButton" Content="Start playing" Width="220" Height="56" Margin="6" Visibility="Collapsed" Click="FinishGrevDad_Click" />
                    <Button x:Name="SkipGrevDadButton" Content="Continue offline" Width="220" Height="56" Margin="6" Click="SkipGrevDad_Click" />
                </StackPanel>
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <local:ControllerQwertyKeyboard x:Name="KeyboardOverlay" Panel.ZIndex="100" />
    </Grid>
</UserControl>
