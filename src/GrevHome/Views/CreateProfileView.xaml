<UserControl x:Class="GrevHome.Views.CreateProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GrevHome.Views"
             Focusable="False">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="72,42" HorizontalAlignment="Center" Width="900">
                <TextBlock Text="Create account"
                           HorizontalAlignment="Center"
                           FontSize="42"
                           FontWeight="SemiBold" />
                <TextBlock Text="Choose the permanent username, then assign the account's Grev Home role."
                           HorizontalAlignment="Center"
                           Margin="0,8,0,24"
                           FontSize="16"
                           Foreground="{StaticResource MutedBrush}" />

                <TextBlock Text="USERNAME • PERMANENT • UP TO 50 CHARACTERS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <Grid Margin="0,7,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ProfileNameTextBox"
                             Height="56"
                             Padding="14,8"
                             FontSize="22"
                             MaxLength="50"
                             IsReadOnly="True"
                             IsTabStop="False" />
                    <Button Grid.Column="1"
                            Content="Open Keyboard"
                            Width="180"
                            Height="56"
                            Margin="10,0,0,0"
                            Click="OpenKeyboard_Click" />
                </Grid>

                <TextBlock Text="ACCOUNT ROLE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,8" />
                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Button x:Name="AdminRoleButton" Content="Admin" Tag="Admin" Width="210" Height="58" Margin="5" Click="Role_Click" />
                    <Button x:Name="StandardRoleButton" Content="Standard" Tag="Standard" Width="210" Height="58" Margin="5" Click="Role_Click" />
                    <Button x:Name="GuestRoleButton" Content="Guest" Tag="Guest" Width="210" Height="58" Margin="5" Click="Role_Click" />
                </WrapPanel>
                <TextBlock x:Name="RoleDescriptionText"
                           Text="Admin • full Grev Home access."
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="StatusText"
                           Text="Display Name starts the same as Username and can be changed later without changing GrevID or folders."
                           Margin="0,0,0,20"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Create Account" Width="210" Height="56" Margin="6" Click="Create_Click" />
                    <Button Content="Cancel" Width="150" Height="56" Margin="6" Click="Cancel_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <local:ControllerQwertyKeyboard x:Name="KeyboardOverlay" Panel.ZIndex="100" />
    </Grid>
</UserControl>
