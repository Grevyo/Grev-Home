<UserControl x:Class="GrevHome.Views.CreateProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="72,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="Create local account"
                       HorizontalAlignment="Center"
                       FontSize="42"
                       FontWeight="SemiBold" />
            <TextBlock Text="Choose the permanent username for this local account."
                       HorizontalAlignment="Center"
                       Margin="0,8,0,24"
                       FontSize="16"
                       Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Width="760" HorizontalAlignment="Center">
            <TextBlock Text="Username • permanent • up to 50 characters" FontSize="14" Foreground="{StaticResource MutedBrush}" />
            <TextBox x:Name="ProfileNameTextBox"
                     Height="54"
                     Margin="0,7,0,14"
                     Padding="14,8"
                     FontSize="22"
                     MaxLength="50" />
            <TextBlock x:Name="StatusText"
                       Text="Your display name starts the same as your username and can be changed later without changing your GrevID or folders."
                       Margin="0,0,0,16"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Width="820" HorizontalAlignment="Center" VerticalAlignment="Center">
            <UniformGrid x:Name="KeyboardGrid" Columns="10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Space" Width="280" Height="52" Margin="5" Click="Space_Click" />
                <Button Content="Backspace" Width="180" Height="52" Margin="5" Click="Backspace_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Create Account" Width="210" Height="56" Margin="6" Click="Create_Click" />
            <Button Content="Cancel" Width="150" Height="56" Margin="6" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</UserControl>
