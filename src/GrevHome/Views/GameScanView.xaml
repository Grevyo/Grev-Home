<UserControl x:Class="GrevHome.Views.GameScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="56,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Scan Directory" FontSize="34" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText"
                       Text="Pick a folder and Grev Home will find the games inside it, work out which console each one is for, and add them all at once."
                       Margin="0,6,0,14"
                       FontSize="15"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" />
            <TextBlock x:Name="PathText"
                       Margin="0,0,0,12"
                       FontSize="16"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource AccentBrush}" />
        </StackPanel>

        <!-- Folder browsing -->
        <ScrollViewer x:Name="BrowseArea"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FolderPanel" />
        </ScrollViewer>

        <!-- Scan results -->
        <ScrollViewer x:Name="ResultsArea"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ResultsPanel" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       Margin="0,0,0,10"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" />

            <WrapPanel x:Name="BrowseActions">
                <Button Content="Scan This Folder" MinWidth="200" Height="54" Margin="0,0,10,0" Click="Scan_Click" />
                <Button Content="Up" Width="110" Height="54" Margin="0,0,10,0" Click="Up_Click" />
                <Button Content="Drives" Width="130" Height="54" Margin="0,0,10,0" Click="Home_Click" />
                <Button Content="Back" Width="120" Height="54" Click="Back_Click" />
            </WrapPanel>

            <WrapPanel x:Name="ResultActions" Visibility="Collapsed">
                <Button x:Name="AddButton" Content="Add Games" MinWidth="200" Height="54" Margin="0,0,10,0" Click="Add_Click" />
                <Button x:Name="BoxArtButton" Content="Box art: On" Width="170" Height="54" Margin="0,0,10,0" Click="ToggleBoxArt_Click" />
                <Button Content="Select All" Width="150" Height="54" Margin="0,0,10,0" Click="SelectAll_Click" />
                <Button Content="Select None" Width="150" Height="54" Margin="0,0,10,0" Click="SelectNone_Click" />
                <Button Content="Choose Folder" Width="180" Height="54" Margin="0,0,10,0" Click="ChooseFolder_Click" />
                <Button Content="Back" Width="120" Height="54" Click="Back_Click" />
            </WrapPanel>
            <Button x:Name="CancelScanButton" Content="Cancel Scan" Width="170" Height="54"
                    HorizontalAlignment="Left" Visibility="Collapsed" Click="CancelScan_Click" />
        </StackPanel>
    </Grid>
</UserControl>
