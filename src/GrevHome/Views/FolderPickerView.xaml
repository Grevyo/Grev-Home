<UserControl x:Class="GrevHome.Views.FolderPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Background="#F2080B11">
        <Grid Margin="54,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="HeadingText" Text="Choose Folder" FontSize="38" FontWeight="SemiBold" />
                    <TextBlock x:Name="LocationText"
                               Text="Files Home"
                               Margin="0,5,0,0"
                               FontSize="15"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="150"
                        Height="48"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Cancel_Click" />
            </Grid>

            <WrapPanel Grid.Row="1" Margin="0,0,0,14">
                <Button x:Name="HomeButton" Content="Home" Width="105" Height="48" Margin="0,0,8,8" Click="Home_Click" />
                <Button x:Name="UpButton" Content="Up" Width="95" Height="48" Margin="0,0,8,8" Click="Up_Click" />
                <Button x:Name="UseFolderButton"
                        Content="Use This Folder"
                        MinWidth="180"
                        Height="48"
                        Margin="0,0,8,8"
                        IsEnabled="False"
                        Click="UseFolder_Click" />
            </WrapPanel>

            <Border Grid.Row="2"
                    Background="#A9151923"
                    BorderBrush="#343D51"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="EmptyText"
                                   Text="This folder has no subfolders."
                                   Visibility="Collapsed"
                                   Margin="8"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="EntriesPanel" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="StatusText"
                       Grid.Row="3"
                       Margin="4,12,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Open a folder, then choose Use This Folder. B goes back through folders and cancels from Home."
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
