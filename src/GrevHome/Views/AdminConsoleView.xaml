<UserControl x:Class="GrevHome.Views.AdminConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="72,38" MaxWidth="1180">
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Admin Console" FontSize="40" FontWeight="SemiBold" />
                    <TextBlock Text="Machine-wide administration. Global App uninstall lives here so normal GrevID libraries cannot accidentally remove software for everyone."
                               Margin="0,6,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="16"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Content="Back"
                        MinWidth="130"
                        MinHeight="48"
                        Height="Auto"
                        Padding="14,10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Back_Click" />
            </Grid>

            <Border Padding="20"
                    Margin="0,0,0,18"
                    Background="#11151E"
                    BorderBrush="#2B3344"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="GLOBAL APPS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="These are installed once for the Windows machine. Uninstall from Machine can affect every GrevID and therefore requires Admin access and a second confirmation."
                               Margin="0,8,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="GlobalAppsPanel" />

            <Border Padding="18"
                    Margin="0,6,0,0"
                    Background="#0B0E15"
                    BorderBrush="#343D51"
                    BorderThickness="1"
                    CornerRadius="12">
                <TextBlock x:Name="StatusText"
                           Text="Select a Global App to manage its machine installation."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
