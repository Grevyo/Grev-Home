<UserControl x:Class="GrevHome.Views.GameSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GrevHome.Views"
             Focusable="False">
    <Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="72,38" MaxWidth="900">
            <TextBlock Text="App Settings" FontSize="40" FontWeight="SemiBold" />
            <TextBlock x:Name="IdentityText" Margin="0,6,0,22" FontSize="15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

            <Border Padding="24" Background="#11151E" BorderBrush="#2B3344" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="GAME PRESENTATION" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Game name" Margin="0,18,0,6" Foreground="{StaticResource MutedBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="DisplayNameBox" MinHeight="48" Padding="12" FontSize="18" IsReadOnly="True" IsTabStop="False" />
                        <Button Grid.Column="1" Content="Open Keyboard" MinWidth="180" Margin="10,0,0,0" Click="OpenNameKeyboard_Click" />
                    </Grid>
                    <Button Content="Save Game Name" Margin="0,10,0,0" MinWidth="190" HorizontalAlignment="Left" Click="SaveName_Click" />

                    <TextBlock Text="CONSOLE LOGO" Margin="0,24,0,6" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="IconStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <Button Content="Choose Console Logo Picture or GIF" Margin="0,10,0,0" MinWidth="300" HorizontalAlignment="Left" Click="ChooseIcon_Click" />
                    <TextBlock Text="Logo position" Margin="0,14,0,6" Foreground="{StaticResource MutedBrush}" />
                    <WrapPanel>
                        <Button Content="Top Left" Tag="TopLeft" Margin="0,0,8,8" Click="LogoPosition_Click" />
                        <Button Content="Top Centre" Tag="TopCenter" Margin="0,0,8,8" Click="LogoPosition_Click" />
                        <Button Content="Top Right" Tag="TopRight" Margin="0,0,8,8" Click="LogoPosition_Click" />
                        <Button Content="Bottom Left" Tag="BottomLeft" Margin="0,0,8,8" Click="LogoPosition_Click" />
                        <Button Content="Bottom Centre" Tag="BottomCenter" Margin="0,0,8,8" Click="LogoPosition_Click" />
                        <Button Content="Bottom Right" Tag="BottomRight" Margin="0,0,8,8" Click="LogoPosition_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="LogoPositionText" Foreground="{StaticResource MutedBrush}" />
                    <Button x:Name="LogoBackgroundButton" Margin="0,12,0,8" MinWidth="260" HorizontalAlignment="Left" Click="LogoBackground_Click" />
                    <TextBlock Text="Logo background colour" Margin="0,6,0,6" Foreground="{StaticResource MutedBrush}" />
                    <WrapPanel>
                        <Button Content="Black" Tag="#000000" Margin="0,0,8,8" Click="LogoBackgroundColor_Click" />
                        <Button Content="White" Tag="#FFFFFF" Margin="0,0,8,8" Click="LogoBackgroundColor_Click" />
                        <Button Content="Blue" Tag="#0F2F6E" Margin="0,0,8,8" Click="LogoBackgroundColor_Click" />
                        <Button Content="Red" Tag="#8B1E2D" Margin="0,0,8,8" Click="LogoBackgroundColor_Click" />
                        <Button Content="Green" Tag="#185C3A" Margin="0,0,8,8" Click="LogoBackgroundColor_Click" />
                        <Button Content="Purple" Tag="#54318C" Margin="0,0,8,8" Click="LogoBackgroundColor_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="LogoBackgroundColorText" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="Console logo scale" Margin="0,14,0,6" Foreground="{StaticResource MutedBrush}" />
                    <WrapPanel>
                        <Button Content="Smaller" MinWidth="130" Margin="0,0,8,8" Click="LogoSmaller_Click" />
                        <Button Content="Larger" MinWidth="130" Margin="0,0,8,8" Click="LogoLarger_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="LogoScaleText" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="SAVED CONSOLE LOGOS" Margin="0,16,0,6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="NoSavedIconsText" Text="No reusable console logos uploaded yet." Foreground="{StaticResource MutedBrush}" />
                    <WrapPanel x:Name="SavedIconsPanel" />

                    <TextBlock Text="FULL TILE" Margin="0,24,0,6" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="TileStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <Button Content="Choose Full Tile Picture or GIF" Margin="0,10,0,0" MinWidth="280" HorizontalAlignment="Left" Click="ChooseTile_Click" />
                    <TextBlock Text="Tile background colour" Margin="0,14,0,6" Foreground="{StaticResource MutedBrush}" />
                    <WrapPanel>
                        <Button Content="Black" Tag="#151923" Margin="0,0,8,8" Click="TileColor_Click" />
                        <Button Content="Blue" Tag="#0F2F6E" Margin="0,0,8,8" Click="TileColor_Click" />
                        <Button Content="Red" Tag="#8B1E2D" Margin="0,0,8,8" Click="TileColor_Click" />
                        <Button Content="Green" Tag="#185C3A" Margin="0,0,8,8" Click="TileColor_Click" />
                        <Button Content="Purple" Tag="#54318C" Margin="0,0,8,8" Click="TileColor_Click" />
                        <Button Content="Orange" Tag="#9A4D12" Margin="0,0,8,8" Click="TileColor_Click" />
                        <Button Content="White" Tag="#FFFFFF" Margin="0,0,8,8" Click="TileColor_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="TileColorText" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="The full tile fills the game tile. The console logo is independent and replaces the platform text at the top-left." Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <Button Content="Save Tile and Console Logo Layout" Margin="0,16,0,0" MinWidth="310" HorizontalAlignment="Left" Click="SaveLayout_Click" />
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,18,0,0">
                <Button Content="Set Back to Default" MinWidth="210" Margin="0,0,10,10" Click="Reset_Click" />
                <Button Content="Back" MinWidth="130" Margin="0,0,10,10" Click="Back_Click" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
      <local:ControllerQwertyKeyboard x:Name="KeyboardOverlay" Panel.ZIndex="100" />
    </Grid>
</UserControl>
