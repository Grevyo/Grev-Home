<UserControl x:Class="GrevHome.Views.GameSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="72,38" MaxWidth="900">
            <TextBlock Text="App Settings" FontSize="40" FontWeight="SemiBold" />
            <TextBlock x:Name="IdentityText" Margin="0,6,0,22" FontSize="15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

            <Border Padding="24" Background="#11151E" BorderBrush="#2B3344" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="GAME PRESENTATION" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Game name" Margin="0,18,0,6" Foreground="{StaticResource MutedBrush}" />
                    <TextBox x:Name="DisplayNameBox" MinHeight="48" Padding="12" FontSize="18" />
                    <Button Content="Save Game Name" Margin="0,10,0,0" MinWidth="190" HorizontalAlignment="Left" Click="SaveName_Click" />

                    <TextBlock Text="CONSOLE LOGO" Margin="0,24,0,6" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="IconStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <Button Content="Choose Console Logo Picture or GIF" Margin="0,10,0,0" MinWidth="300" HorizontalAlignment="Left" Click="ChooseIcon_Click" />
                    <TextBlock Text="Logo position" Margin="0,14,0,6" Foreground="{StaticResource MutedBrush}" />
                    <ComboBox x:Name="LogoPositionBox" Width="240" MinHeight="44" HorizontalAlignment="Left" />
                    <CheckBox x:Name="LogoBackgroundCheckBox" Content="Show a background behind the console logo" Margin="0,14,0,0" />
                    <TextBlock Text="Logo background colour (#RRGGBB)" Margin="0,10,0,6" Foreground="{StaticResource MutedBrush}" />
                    <TextBox x:Name="LogoBackgroundColorBox" Width="180" MinHeight="42" Padding="10" HorizontalAlignment="Left" />
                    <TextBlock Text="Console logo scale" Margin="0,14,0,6" Foreground="{StaticResource MutedBrush}" />
                    <Slider x:Name="LogoScaleSlider" Width="300" Minimum="0.5" Maximum="2.5" TickFrequency="0.25" IsSnapToTickEnabled="True" HorizontalAlignment="Left" />
                    <TextBlock Text="SAVED CONSOLE LOGOS" Margin="0,16,0,6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="NoSavedIconsText" Text="No reusable console logos uploaded yet." Foreground="{StaticResource MutedBrush}" />
                    <WrapPanel x:Name="SavedIconsPanel" />

                    <TextBlock Text="FULL TILE" Margin="0,24,0,6" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="TileStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <Button Content="Choose Full Tile Picture or GIF" Margin="0,10,0,0" MinWidth="280" HorizontalAlignment="Left" Click="ChooseTile_Click" />
                    <TextBlock Text="Tile background colour (#RRGGBB)" Margin="0,14,0,6" Foreground="{StaticResource MutedBrush}" />
                    <TextBox x:Name="TileColorBox" Width="180" MinHeight="42" Padding="10" HorizontalAlignment="Left" />
                    <TextBlock Text="The full tile fills the game tile. The console logo is independent and replaces the platform text at the top-left." Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <Button Content="Save Tile and Console Logo Layout" Margin="0,16,0,0" MinWidth="310" HorizontalAlignment="Left" Click="SaveLayout_Click" />
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,18,0,0">
                <Button Content="Set Back to Default" MinWidth="210" Margin="0,0,10,10" Click="Reset_Click" />
                <Button Content="Back" MinWidth="130" Margin="0,0,10,10" Click="Back_Click" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
