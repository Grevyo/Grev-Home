<UserControl x:Class="GrevHome.Views.FriendProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="FriendProfileSectionCard" TargetType="Border">
            <Setter Property="Background" Value="#11151E" />
            <Setter Property="BorderBrush" Value="#252D3B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="FriendProfileEyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="54,26,54,48" MaxWidth="900">
            <Button x:Name="BackButton" Content="← Back to Friends" Width="200" Height="46" HorizontalAlignment="Left" Click="Back_Click" />
            <Button x:Name="MessageButton" Content="Message friend" Width="200" Height="46" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Message_Click" />

            <Border x:Name="HeaderCard"
                    Margin="0,18,0,0"
                    BorderBrush="#354158"
                    BorderThickness="2"
                    CornerRadius="0"
                    Padding="28">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="AvatarBorder"
                            Width="96" Height="96"
                            Background="#1F283A"
                            BorderBrush="#354158"
                            BorderThickness="2"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                            <TextBlock x:Name="AvatarText"
                                       Text="?"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DisplayNameText" Text="Friend" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock x:Name="VerifiedText"
                                       Text="✓ VERIFIED"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="UsernameText"
                                   Margin="0,6,0,0"
                                   FontSize="16"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="StatusText"
                                   Margin="0,10,0,0"
                                   FontSize="14"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="BioText" TextWrapping="Wrap" FontSize="18" Margin="0,18,0,0" />
            <UniformGrid Columns="2" Margin="0,18,0,0">
                <Border Style="{StaticResource FriendProfileSectionCard}">
                    <StackPanel>
                        <TextBlock Text="LEVEL &amp; XP" Style="{StaticResource FriendProfileEyebrow}" />
                        <TextBlock x:Name="LevelText" Text="—" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FriendProfileSectionCard}">
                    <StackPanel>
                        <TextBlock Text="FRIENDS SINCE" Style="{StaticResource FriendProfileEyebrow}" />
                        <TextBlock x:Name="FriendsSinceText" Text="—" Margin="0,6,0,0" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="RECENT ACTIVITY" Margin="0,22,0,8" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
            <StackPanel x:Name="ActivityPanel" />
            <TextBlock x:Name="NoActivityText"
                       Text="No recent shared activity from this friend."
                       Foreground="{StaticResource MutedBrush}"
                       Margin="8,4,8,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
