<UserControl x:Class="GrevHome.Views.AppKillerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="72,42">
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="App Killer" FontSize="38" FontWeight="SemiBold" />
                    <TextBlock Text="Close Grev Home apps normally first. Force Close is a deliberate second-step action."
                               Margin="0,6,0,0"
                               FontSize="16"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Button Content="Back"
                        Width="120"
                        Height="48"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Back_Click" />
            </Grid>

            <TextBlock x:Name="EmptyText"
                       Text="No Grev Home apps are currently running."
                       Margin="8,20"
                       FontSize="18"
                       Foreground="{StaticResource MutedBrush}" />

            <WrapPanel x:Name="SessionsPanel" />

            <Border Margin="8,28,8,0"
                    Padding="22"
                    Background="#11151E"
                    BorderBrush="#2B3344"
                    BorderThickness="1"
                    CornerRadius="12">
                <TextBlock x:Name="StatusText"
                           Text="Force Close can interrupt saves/config writes. It always requires pressing the same Force Close action twice."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
