<UserControl x:Class="GrevHome.Views.AppKillerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="AppKillerActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="MaxWidth" Value="240" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="72,38" MaxWidth="1420">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="App Killer"
                               FontSize="40"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Manage apps Grev Home is actively tracking. Close Normally is the safe first choice; Force Kill is the emergency option and always needs confirmation."
                               Margin="0,7,0,0"
                               FontSize="15"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Back"
                        MinWidth="130"
                        Height="Auto"
                        MinHeight="50"
                        Padding="16,10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Back_Click" />
            </Grid>

            <Border Padding="18"
                    Margin="0,0,0,18"
                    Background="#11151E"
                    BorderBrush="#2B3344"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="ACTIVE SESSIONS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="SessionSummaryText"
                                   Text="0"
                                   Margin="0,4,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="TRACKED PROCESSES"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="ProcessSummaryText"
                                   Text="0"
                                   Margin="0,4,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="EmptyText"
                       Text="No Grev Home apps are currently running."
                       Margin="8,24"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="18"
                       Foreground="{StaticResource MutedBrush}" />

            <StackPanel x:Name="SessionsPanel" />

            <Border Margin="0,20,0,0"
                    Padding="20"
                    Background="#11151E"
                    BorderBrush="#2B3344"
                    BorderThickness="1"
                    CornerRadius="12">
                <TextBlock x:Name="StatusText"
                           Text="Select a running app. Force Kill can interrupt saves or configuration writes and always requires a second press on the same session."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
