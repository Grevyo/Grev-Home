<UserControl x:Class="GrevHome.Views.ProfileEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="72,38" MaxWidth="1100">
            <TextBlock Text="Edit Profile" FontSize="40" FontWeight="SemiBold" />
            <TextBlock x:Name="IdentityText" Margin="0,6,0,22" FontSize="15" Foreground="{StaticResource MutedBrush}" />

            <Border Background="#11151E" BorderBrush="#2B3344" BorderThickness="1" CornerRadius="16" Padding="24">
                <StackPanel>
                    <TextBlock Text="AVATAR" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                        <Border Width="84" Height="84" CornerRadius="42" Background="#1F283A" Margin="0,0,18,0">
                            <TextBlock x:Name="AvatarPreviewText" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <WrapPanel x:Name="AvatarButtonsPanel" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="DISPLAY NAME" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBox x:Name="DisplayNameTextBox" MaxLength="50" Height="52" Margin="0,8,0,10" FontSize="20" Padding="12" />
                    <WrapPanel x:Name="KeyboardPanel" Margin="0,0,0,18" />
                    <WrapPanel Margin="0,0,0,22">
                        <Button Content="Space" Width="120" Height="48" Margin="3" Click="Space_Click" />
                        <Button Content="⌫" Width="90" Height="48" Margin="3" Click="Backspace_Click" />
                    </WrapPanel>

                    <StackPanel x:Name="RolePanel">
                        <TextBlock Text="ACCOUNT ROLE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="RoleDescriptionText" Margin="0,6,0,8" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button x:Name="AdminRoleButton" Content="Admin" Tag="Admin" Width="150" Height="50" Margin="3" Click="Role_Click" />
                            <Button x:Name="StandardRoleButton" Content="Standard" Tag="Standard" Width="150" Height="50" Margin="3" Click="Role_Click" />
                            <Button x:Name="GuestRoleButton" Content="Guest" Tag="Guest" Width="150" Height="50" Margin="3" Click="Role_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock x:Name="RoleLockedText" Visibility="Collapsed" Margin="0,0,0,6" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                    <Button Content="Save Profile" Width="190" Height="56" Margin="0,26,0,0" HorizontalAlignment="Left" Click="Save_Click" />
                    <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
