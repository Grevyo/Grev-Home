<UserControl x:Class="GrevHome.Views.ProfileEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GrevHome.Views"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="EditSectionCard" TargetType="Border">
            <Setter Property="Background" Value="#11151E" />
            <Setter Property="BorderBrush" Value="#252D3B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style x:Key="EditEyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="EditHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="54,26,54,48" MaxWidth="1120">
                <TextBlock Text="EDIT PROFILE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Make this profile yours" Margin="0,3,0,0" FontSize="30" FontWeight="SemiBold" />
                <TextBlock x:Name="IdentityText" Margin="0,6,0,18" FontSize="13" Foreground="{StaticResource MutedBrush}" />

                <Border x:Name="ProfileEditCard"
                        Background="Transparent"
                        BorderBrush="{StaticResource GuestRoleBrush}"
                        BorderThickness="0"
                        CornerRadius="0">
                    <StackPanel>
                        <Border Style="{StaticResource EditSectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="AvatarPreviewBorder"
                                        Width="132"
                                        Height="132"
                                        CornerRadius="0"
                                        Background="#1F283A"
                                        BorderBrush="{StaticResource GuestRoleBrush}"
                                        BorderThickness="4"
                                        Margin="0,0,24,0"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="AvatarPreviewImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                        <TextBlock x:Name="AvatarPreviewText" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PROFILE PICTURE" Style="{StaticResource EditEyebrow}" />
                                    <TextBlock Text="Choose an avatar or use your own photo." Margin="0,5,0,10" Style="{StaticResource EditHint}" />
                                    <WrapPanel x:Name="AvatarButtonsPanel" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Choose Custom Photo" Width="200" Height="48" Margin="3" Click="ChoosePhoto_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="AvatarChoiceText" Margin="4,8,0,0" Style="{StaticResource EditHint}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource EditSectionCard}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="PROFILE DETAILS" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="These are the details people see on your Grev Home profile." Margin="0,4,0,18" Style="{StaticResource EditHint}" />

                                <TextBlock Text="DISPLAY NAME" Style="{StaticResource EditEyebrow}" />
                                <Grid Margin="0,8,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DisplayNameTextBox"
                                             MaxLength="50"
                                             Height="52"
                                             FontSize="20"
                                             Padding="12"
                                             IsReadOnly="True"
                                             IsTabStop="True"
                                             Focusable="True" />
                                    <Button Grid.Column="1" Content="Open Keyboard" Width="180" Height="52" Margin="10,0,0,0" Click="OpenKeyboard_Click" />
                                </Grid>

                                <TextBlock Text="STATUS / TAGLINE" Style="{StaticResource EditEyebrow}" />
                                <Grid Margin="0,8,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="StatusMessageTextBox"
                                             MaxLength="60"
                                             Height="52"
                                             FontSize="16"
                                             Padding="12"
                                             IsReadOnly="True"
                                             IsTabStop="True"
                                             Focusable="True" />
                                    <Button Grid.Column="1" Content="Open Keyboard" Width="180" Height="52" Margin="10,0,0,0" Click="OpenStatusKeyboard_Click" />
                                </Grid>

                                <TextBlock Text="ABOUT" Style="{StaticResource EditEyebrow}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BioTextBox"
                                             MaxLength="160"
                                             MinHeight="78"
                                             FontSize="16"
                                             Padding="12"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Center"
                                             IsReadOnly="True"
                                             IsTabStop="True"
                                             Focusable="True" />
                                    <Button Grid.Column="1" Content="Open Keyboard" Width="180" Height="52" Margin="10,0,0,0" VerticalAlignment="Center" Click="OpenBioKeyboard_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource EditSectionCard}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="PROFILE APPEARANCE &amp; ROLE" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Your role also supplies the accent used around your profile identity." Margin="0,4,0,16" Style="{StaticResource EditHint}" />

                                <StackPanel x:Name="RolePanel">
                                    <TextBlock Text="ACCOUNT ROLE" Style="{StaticResource EditEyebrow}" />
                                    <TextBlock x:Name="RoleDescriptionText" Margin="0,6,0,10" Style="{StaticResource EditHint}" />
                                    <WrapPanel>
                                        <Button x:Name="AdminRoleButton" Content="Admin" Tag="Admin" Width="150" Height="50" Margin="3" BorderBrush="{StaticResource AdminRoleBrush}" Click="Role_Click" />
                                        <Button x:Name="StandardRoleButton" Content="Standard" Tag="Standard" Width="150" Height="50" Margin="3" BorderBrush="{StaticResource StandardRoleBrush}" Click="Role_Click" />
                                        <Button x:Name="GuestRoleButton" Content="Guest" Tag="Guest" Width="150" Height="50" Margin="3" BorderBrush="{StaticResource GuestRoleBrush}" Click="Role_Click" />
                                    </WrapPanel>
                                </StackPanel>

                                <TextBlock x:Name="RoleLockedText" Visibility="Collapsed" Margin="3,10,0,0" Style="{StaticResource EditHint}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0"
                                Padding="18"
                                Background="#0D1119"
                                BorderBrush="#252D3B"
                                BorderThickness="1"
                                CornerRadius="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ready to save?" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Your Username and GrevID remain permanent." Margin="0,3,0,0" Style="{StaticResource EditHint}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Save Profile" Width="190" Height="54" Margin="18,0,0,0" Click="Save_Click" />
                            </Grid>
                        </Border>

                        <TextBlock x:Name="StatusText" Margin="4,12,4,0" Style="{StaticResource EditHint}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <local:ControllerQwertyKeyboard x:Name="KeyboardOverlay" Panel.ZIndex="100" />
    </Grid>
</UserControl>
