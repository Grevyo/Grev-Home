<UserControl x:Class="GrevHome.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="72,38" MaxWidth="1180">
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="40" FontWeight="SemiBold" />
                    <TextBlock Text="Account presentation and machine-wide controller system shortcuts."
                               Margin="0,6,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="16" />
                </StackPanel>
                <Button Content="Back"
                        Width="130"
                        Height="48"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Back_Click" />
            </Grid>

            <TextBlock Text="ACCOUNT" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,8" />
            <Border Background="#11151E" BorderBrush="#2B3344" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,28">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="DisplayNameText" Text="Display name" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="UsernameText" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="GrevIdText" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <Button x:Name="EditDisplayNameButton"
                                Grid.Column="1"
                                Content="Edit Display Name"
                                Width="190"
                                Height="48"
                                VerticalAlignment="Center"
                                Click="EditDisplayName_Click" />
                    </Grid>

                    <Border x:Name="DisplayNameEditor"
                            Visibility="Collapsed"
                            Margin="0,20,0,0"
                            Padding="18"
                            Background="#0B0E15"
                            BorderBrush="#343D51"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="Display name" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="DisplayNameTextBox"
                                     Height="52"
                                     Margin="0,7,0,12"
                                     Padding="13,7"
                                     FontSize="21"
                                     MaxLength="50" />
                            <UniformGrid x:Name="DisplayNameKeyboard" Columns="10" Margin="0,2,0,4" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Space" Width="220" Height="48" Margin="5" Click="DisplayNameSpace_Click" />
                                <Button Content="Backspace" Width="170" Height="48" Margin="5" Click="DisplayNameBackspace_Click" />
                                <Button Content="Save" Width="140" Height="48" Margin="5" Click="SaveDisplayName_Click" />
                                <Button Content="Cancel" Width="140" Height="48" Margin="5" Click="CancelDisplayName_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="AccountStatusText"
                               Margin="0,14,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="CONTROLLER SYSTEM SHORTCUTS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,8" />
            <Border Background="#11151E" BorderBrush="#2B3344" BorderThickness="1" CornerRadius="14" Padding="22">
                <StackPanel>
                    <TextBlock Text="These shortcuts are machine-wide and continue working while external apps are running."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />

                    <TextBlock Text="RETURN HOME" Margin="0,22,0,8" FontSize="13" FontWeight="Bold" />
                    <StackPanel x:Name="ReturnHomeBindingsPanel" />
                    <Button Content="＋ Record another Return Home combination"
                            Height="52"
                            Margin="0,6,0,0"
                            Click="AddReturnHome_Click" />

                    <TextBlock Text="GREV OVERLAY" Margin="0,26,0,8" FontSize="13" FontWeight="Bold" />
                    <StackPanel x:Name="OverlayBindingsPanel" />
                    <Button Content="＋ Record another Overlay combination"
                            Height="52"
                            Margin="0,6,0,0"
                            Click="AddOverlay_Click" />

                    <Border x:Name="CapturePanel"
                            Visibility="Collapsed"
                            Margin="0,22,0,0"
                            Padding="20"
                            Background="#0B0E15"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock x:Name="CaptureTitleText" Text="Recording combination…" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="CaptureInstructionsText"
                                       Margin="0,7,0,0"
                                       Text="Release the button used to start recording, then hold your new combination together and release it."
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />
                            <Button Content="Cancel recording"
                                    Width="180"
                                    Height="46"
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    Click="CancelCapture_Click" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button Content="Reset shortcuts to defaults"
                                Width="240"
                                Height="50"
                                Margin="0,0,10,0"
                                Click="ResetShortcuts_Click" />
                    </StackPanel>

                    <TextBlock x:Name="ShortcutStatusText"
                               Margin="0,14,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
