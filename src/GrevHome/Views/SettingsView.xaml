<UserControl x:Class="GrevHome.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="WrappedSettingsButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSectionHeaderButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WrappedSettingsButtonStyle}">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   TextAlignment="Left"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="72,38" MaxWidth="1180">
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="40" FontWeight="SemiBold" />
                    <TextBlock Text="Account, controller and machine settings for this Grev Home system. Open only the section you need."
                               Margin="0,6,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="16"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Content="Back"
                        MinWidth="130"
                        MinHeight="48"
                        Height="Auto"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource WrappedSettingsButtonStyle}"
                        Click="Back_Click" />
            </Grid>

            <StackPanel Margin="0,0,0,16">
                <Button x:Name="AccountSectionButton"
                        Content="ACCOUNT  ▾"
                        Style="{StaticResource SettingsSectionHeaderButtonStyle}"
                        Click="AccountSectionButton_Click" />
                <Border x:Name="AccountSectionContent"
                        Visibility="Collapsed"
                        Background="#11151E"
                        BorderBrush="#2B3344"
                        BorderThickness="1,0,1,1"
                        Padding="22"
                        CornerRadius="0,0,14,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="DisplayNameText" Text="Display name" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="UsernameText" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="GrevIdText" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="EditDisplayNameButton"
                                    Grid.Column="1"
                                    Content="Edit Display Name"
                                    MinWidth="190"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource WrappedSettingsButtonStyle}"
                                    Click="EditDisplayName_Click" />
                        </Grid>

                        <Border x:Name="DisplayNameEditor"
                                Visibility="Collapsed"
                                Margin="0,20,0,0"
                                Padding="18"
                                Background="#0B0E15"
                                BorderBrush="#343D51"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="Display name" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="DisplayNameTextBox"
                                         Height="52"
                                         Margin="0,7,0,12"
                                         Padding="13,7"
                                         FontSize="21"
                                         MaxLength="50" />
                                <UniformGrid x:Name="DisplayNameKeyboard" Columns="10" Margin="0,2,0,4" />
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Content="Space" MinWidth="220" Margin="5" Style="{StaticResource WrappedSettingsButtonStyle}" Click="DisplayNameSpace_Click" />
                                    <Button Content="Backspace" MinWidth="170" Margin="5" Style="{StaticResource WrappedSettingsButtonStyle}" Click="DisplayNameBackspace_Click" />
                                    <Button Content="Save" MinWidth="140" Margin="5" Style="{StaticResource WrappedSettingsButtonStyle}" Click="SaveDisplayName_Click" />
                                    <Button Content="Cancel" MinWidth="140" Margin="5" Style="{StaticResource WrappedSettingsButtonStyle}" Click="CancelDisplayName_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="AccountStatusText"
                                   Margin="0,14,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <Button x:Name="ControllerShortcutsSectionButton"
                        Content="CONTROLLER SYSTEM SHORTCUTS  ▾"
                        Style="{StaticResource SettingsSectionHeaderButtonStyle}"
                        Click="ControllerShortcutsSectionButton_Click" />
                <Border x:Name="ControllerShortcutsSectionContent"
                        Visibility="Collapsed"
                        Background="#11151E"
                        BorderBrush="#2B3344"
                        BorderThickness="1,0,1,1"
                        Padding="22"
                        CornerRadius="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="These shortcuts are machine-wide and continue working while external apps are running."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="RETURN HOME" Margin="0,22,0,8" FontSize="13" FontWeight="Bold" />
                        <StackPanel x:Name="ReturnHomeBindingsPanel" />
                        <Button Content="＋ Record another Return Home combination"
                                Margin="0,6,0,0"
                                Style="{StaticResource WrappedSettingsButtonStyle}"
                                Click="AddReturnHome_Click" />

                        <TextBlock Text="GREV OVERLAY" Margin="0,26,0,8" FontSize="13" FontWeight="Bold" />
                        <StackPanel x:Name="OverlayBindingsPanel" />
                        <Button Content="＋ Record another Overlay combination"
                                Margin="0,6,0,0"
                                Style="{StaticResource WrappedSettingsButtonStyle}"
                                Click="AddOverlay_Click" />

                        <Border x:Name="CapturePanel"
                                Visibility="Collapsed"
                                Margin="0,22,0,0"
                                Padding="20"
                                Background="#0B0E15"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock x:Name="CaptureTitleText" Text="Recording combination…" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="CaptureInstructionsText"
                                           Margin="0,7,0,0"
                                           Text="Release the button used to start recording, then hold your new combination together and release it."
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" />
                                <Button Content="Cancel recording"
                                        MinWidth="180"
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource WrappedSettingsButtonStyle}"
                                        Click="CancelCapture_Click" />
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,24,0,0">
                            <Button Content="Reset shortcuts to defaults"
                                    MinWidth="240"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource WrappedSettingsButtonStyle}"
                                    Click="ResetShortcuts_Click" />
                        </WrapPanel>

                        <TextBlock x:Name="ShortcutStatusText"
                                   Margin="0,14,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <Button x:Name="SystemStatusSectionButton"
                        Content="SYSTEM STATUS  ▾"
                        Style="{StaticResource SettingsSectionHeaderButtonStyle}"
                        Click="SystemStatusSectionButton_Click" />
                <Border x:Name="SystemStatusSectionContent"
                        Visibility="Collapsed"
                        Background="#11151E"
                        BorderBrush="#2B3344"
                        BorderThickness="1,0,1,1"
                        Padding="22"
                        CornerRadius="0,0,14,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="MachineNameText" Text="This Grev Machine" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="WindowsText" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="MachineResourcesText" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="MachinePowerText" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Refresh status"
                                    MinWidth="160"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource WrappedSettingsButtonStyle}"
                                    Click="RefreshSystemStatus_Click" />
                        </Grid>

                        <TextBlock Text="STORAGE" Margin="0,24,0,8" FontSize="13" FontWeight="Bold" />
                        <StackPanel x:Name="StorageStatusPanel" />

                        <TextBlock Text="CONTROLLERS" Margin="0,24,0,8" FontSize="13" FontWeight="Bold" />
                        <StackPanel x:Name="ControllerHardwarePanel" />

                        <TextBlock x:Name="SystemStatusText"
                                   Margin="0,14,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <Button x:Name="PowerSectionButton"
                        Content="POWER  ▾"
                        Style="{StaticResource SettingsSectionHeaderButtonStyle}"
                        Click="PowerSectionButton_Click" />
                <Border x:Name="PowerSectionContent"
                        Visibility="Collapsed"
                        Background="#11151E"
                        BorderBrush="#2B3344"
                        BorderThickness="1,0,1,1"
                        Padding="22"
                        CornerRadius="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="Power actions affect the whole Windows machine. Select an action once to arm it, then select the same action again within 8 seconds to confirm."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />

                        <WrapPanel Margin="0,18,0,0">
                            <Button x:Name="SleepButton" Content="Sleep" MinWidth="210" MinHeight="64" Margin="0,0,10,10" Style="{StaticResource WrappedSettingsButtonStyle}" Click="Sleep_Click" />
                            <Button x:Name="RestartButton" Content="Restart" MinWidth="210" MinHeight="64" Margin="0,0,10,10" Style="{StaticResource WrappedSettingsButtonStyle}" Click="Restart_Click" />
                            <Button x:Name="ShutdownButton" Content="Shut Down" MinWidth="210" MinHeight="64" Margin="0,0,10,10" Style="{StaticResource WrappedSettingsButtonStyle}" Click="Shutdown_Click" />
                            <Button Content="Cancel power action" MinWidth="210" MinHeight="64" Margin="0,0,10,10" Style="{StaticResource WrappedSettingsButtonStyle}" Click="CancelPowerAction_Click" />
                        </WrapPanel>

                        <TextBlock x:Name="PowerStatusText"
                                   Margin="0,8,0,0"
                                   Text="No power action armed."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
