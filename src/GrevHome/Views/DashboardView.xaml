<UserControl x:Class="GrevHome.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="DashboardTileStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="285" />
            <Setter Property="Height" Value="145" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="DashboardTileTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DashboardTileDetailStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DashboardCarouselStyle" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="PanningMode" Value="HorizontalOnly" />
            <Setter Property="CanContentScroll" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClipToBounds" Value="True" />
            <EventSetter Event="ScrollChanged" Handler="Carousel_ScrollChanged" />
            <EventSetter Event="PreviewMouseWheel" Handler="Carousel_PreviewMouseWheel" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  CanContentScroll="False">
        <StackPanel Margin="64,38,64,46">
            <StackPanel Margin="8,0,8,28">
                <TextBlock x:Name="WelcomeText"
                           Text="Welcome"
                           FontSize="38"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SessionUsersText"
                           Margin="0,6,0,0"
                           FontSize="15"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="ActivitySection"
                        Visibility="Collapsed"
                        Margin="0,0,0,22">
                <TextBlock Text="CONTINUE &amp; RECENT"
                           Margin="10,0,0,8"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="ActivitySummaryText"
                           Margin="10,0,10,6"
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
                <ScrollViewer Style="{StaticResource DashboardCarouselStyle}">
                    <StackPanel Orientation="Horizontal">
                    <Button x:Name="ContinueButton"
                            Style="{StaticResource DashboardTileStyle}"
                            Visibility="Collapsed"
                            Click="ActivityApp_Click">
                        <StackPanel>
                            <TextBlock Text="Continue" Style="{StaticResource DashboardTileTitleStyle}" />
                            <TextBlock x:Name="ContinueAppNameText"
                                       Margin="0,5,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ContinueDetailText"
                                       Style="{StaticResource DashboardTileDetailStyle}" />
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="RecentAppsPanel" Orientation="Horizontal" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <TextBlock Text="APPS &amp; CONTENT"
                       Margin="10,0,0,8"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedBrush}" />
            <ScrollViewer Style="{StaticResource DashboardCarouselStyle}" Margin="0,0,0,22">
                <StackPanel Orientation="Horizontal">
                <Button x:Name="YourGamesButton" Tag="your-games" Style="{StaticResource DashboardTileStyle}" Click="YourGames_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick">
                    <StackPanel>
                        <TextBlock Text="Your Games" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock x:Name="GamesSummaryText" Text="Open your complete game library" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="InstalledAppsButton" Tag="installed-apps" Style="{StaticResource DashboardTileStyle}" Click="InstalledApps_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick">
                    <StackPanel>
                        <TextBlock Text="Installed Apps" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Apps, emulators and individual games" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="StoreButton" Tag="grev-store" Style="{StaticResource DashboardTileStyle}" Click="Store_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick">
                    <StackPanel>
                        <TextBlock Text="Grev Store" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Browse supported apps" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="FilesButton" Tag="files" Style="{StaticResource DashboardTileStyle}" Click="Files_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick">
                    <StackPanel>
                        <TextBlock Text="Files" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Browse local files and folders" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="GrevDadButton" Tag="grev-dad" Content="Grev.dad" Style="{StaticResource DashboardTileStyle}" Click="GrevDad_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                <Button x:Name="WebBrowserButton" Tag="web-browser" Content="Grev's Web Browser" Style="{StaticResource DashboardTileStyle}" Click="WebBrowser_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                </StackPanel>
            </ScrollViewer>

            <TextBlock Text="SYSTEM"
                       Margin="10,0,0,8"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedBrush}" />
            <ScrollViewer Style="{StaticResource DashboardCarouselStyle}">
                <StackPanel Orientation="Horizontal">
                <Button x:Name="RunningAppsButton"
                        Tag="running-apps"
                        Style="{StaticResource DashboardTileStyle}"
                        PreviewMouseRightButtonUp="DashboardTile_RightClick"
                        Click="RunningApps_Click">
                    <StackPanel>
                        <TextBlock Text="Running Apps" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock x:Name="RunningCountText"
                                   Text="0 active"
                                   Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ActivityCenterButton" Tag="activity-center" Style="{StaticResource DashboardTileStyle}" Click="ActivityCenter_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick">
                    <StackPanel>
                        <TextBlock Text="Activity Center" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock x:Name="ActivityCenterDetailText"
                                   Text="Notifications and downloads"
                                   Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="AppKillerButton" Tag="app-killer" Style="{StaticResource DashboardTileStyle}" Click="AppKiller_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick">
                    <StackPanel>
                        <TextBlock Text="App Killer" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Manage or force-close a stuck app" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsButton" Tag="settings" Style="{StaticResource DashboardTileStyle}" Click="Settings_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Grev Home and controller settings" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="AdminConsoleButton"
                        Tag="admin-console"
                        Style="{StaticResource DashboardTileStyle}"
                        Visibility="Collapsed"
                        PreviewMouseRightButtonUp="DashboardTile_RightClick"
                        Click="AdminConsole_Click">
                    <StackPanel>
                        <TextBlock Text="Admin Console" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Machine, apps and account administration" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="FriendsSection" Visibility="Collapsed" Margin="0,24,0,0">
                <Grid Margin="10,0,10,8">
                    <TextBlock Text="FRIENDS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="FriendsSummaryText" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                </Grid>
                <ScrollViewer Style="{StaticResource DashboardCarouselStyle}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel x:Name="FriendsPanel" Orientation="Horizontal" />
                        <Button Content="Open Friends" Width="285" Height="86" Margin="8" Click="Friends_Click" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <TextBlock x:Name="DashboardStatusText"
                       Visibility="Collapsed"
                       Margin="10,18,10,0"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="13"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
