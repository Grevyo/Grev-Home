<UserControl x:Class="GrevHome.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="72,42">
            <Grid Margin="0,0,0,26">
                <StackPanel>
                    <TextBlock x:Name="WelcomeText" Text="Welcome" FontSize="38" FontWeight="SemiBold" />
                    <TextBlock x:Name="SessionUsersText"
                               Margin="0,6,0,0"
                               FontSize="16"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Users &amp; Controllers"
                            Width="210"
                            Height="48"
                            Margin="0,0,10,0"
                            Click="ManageUsers_Click" />
                    <Button Content="Log out"
                            Width="130"
                            Height="48"
                            Click="Logout_Click" />
                </StackPanel>
            </Grid>

            <TextBlock Text="YOUR DASHBOARD" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,10" />
            <WrapPanel>
                <Button Width="285" Height="145" Margin="8" Click="InstalledApps_Click" Content="Installed Apps" />
                <Button x:Name="RunningAppsButton" Width="285" Height="145" Margin="8" Click="RunningApps_Click" Content="Running Apps&#x0a;0 active" />
                <Button Width="285" Height="145" Margin="8" Click="AppKiller_Click" Content="App Killer" />
                <Button Width="285" Height="145" Margin="8" Click="Settings_Click" Content="Settings &amp; System" />
                <Button Width="285" Height="145" Margin="8" Click="Files_Click" Content="Files" />
                <Button Tag="Recently Used" Width="285" Height="145" Margin="8" Click="Placeholder_Click" Content="Recently Used" />
                <Button Tag="Emulators" Width="285" Height="145" Margin="8" Click="Placeholder_Click" Content="Emulators" />
                <Button Tag="Grev Store" Width="285" Height="145" Margin="8" Click="Placeholder_Click" Content="Grev Store • later" />
            </WrapPanel>

            <Border Margin="8,28,8,0"
                    Padding="22"
                    Background="#11151E"
                    BorderBrush="#2B3344"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="Foundation status" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,8,0,0"
                               Text="0.8 adds the first Grev File Explorer: controller-first drives/folders/files and safe file-management operations inside the persistent shell."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
