<UserControl x:Class="GrevHome.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:GrevHome.Presentation"
             Focusable="False">
    <UserControl.Resources>
        <presentation:RoundedClipConverter x:Key="RoundedClip" />
        <!-- Set from the active theme's layout (ThemeLayout.EffectiveCornerRadius). -->
        <CornerRadius x:Key="DashboardTileCornerRadius">0</CornerRadius>
        <Style x:Key="DashboardTileStyle"
               TargetType="Button"
               BasedOn="{StaticResource SharpTileButtonStyle}">
            <Setter Property="Width" Value="285" />
            <Setter Property="Height" Value="145" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <EventSetter Event="MouseEnter" Handler="DashboardTile_MouseEnter" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource DashboardTileCornerRadius}">
                                <Border.Clip>
                                    <MultiBinding Converter="{StaticResource RoundedClip}">
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </Border.Clip>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <Border CornerRadius="{DynamicResource DashboardTileCornerRadius}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DashboardTileTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DashboardTileDetailStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DashboardCarouselStyle" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="PanningMode" Value="HorizontalOnly" />
            <Setter Property="CanContentScroll" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClipToBounds" Value="True" />
            <EventSetter Event="ScrollChanged" Handler="Carousel_ScrollChanged" />
            <EventSetter Event="PreviewMouseWheel" Handler="Carousel_PreviewMouseWheel" />
        </Style>
    </UserControl.Resources>

    <!-- Home's arrangement comes from the active theme (ThemeLayout); see ApplyLayout in the
         code-behind. Every tile and handler below is the same in every layout. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="BladePanel" Orientation="Horizontal" Margin="28,38,0,46" Visibility="Collapsed" />

    <ScrollViewer x:Name="DashboardScroll"
                  Grid.Column="1"
                  VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  CanContentScroll="False"
                  PreviewMouseWheel="Dashboard_PreviewMouseWheel">
        <Grid x:Name="DashboardContent" Margin="64,38,64,46">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="WelcomeHeader" Margin="8,0,8,28">
                <TextBlock x:Name="WelcomeText"
                           Text="Welcome"
                           FontSize="38"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SessionUsersText"
                           Margin="0,6,0,0"
                           FontSize="15"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="FocusedTitleText"
                       Grid.Row="1"
                       Visibility="Collapsed"
                       Margin="10,0,10,18"
                       FontSize="34"
                       TextTrimming="CharacterEllipsis" />

            <WrapPanel x:Name="TabBarPanel" Grid.Row="2" Visibility="Collapsed" Margin="4,0,4,20" />

            <ScrollViewer x:Name="SectionsScroll"
                          Grid.Row="3"
                          Style="{StaticResource DashboardCarouselStyle}"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SectionsHost">
            <StackPanel x:Name="ActivitySection"
                        Visibility="Collapsed"
                        Margin="0,0,0,22">
                <TextBlock x:Name="ActivityHeading" Text="CONTINUE &amp; RECENT"
                           Margin="10,0,0,8"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock x:Name="ActivitySummaryText"
                           Margin="10,0,10,6"
                           FontSize="14"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />
                <ScrollViewer x:Name="RecentCarousel" Style="{StaticResource DashboardCarouselStyle}">
                    <StackPanel Orientation="Horizontal">
                    <Button x:Name="ContinueButton"
                            Style="{StaticResource DashboardTileStyle}"
                            Visibility="Collapsed"
                            Click="ActivityApp_Click">
                        <StackPanel>
                            <TextBlock Text="Continue" Style="{StaticResource DashboardTileTitleStyle}" />
                            <TextBlock x:Name="ContinueAppNameText"
                                       Margin="0,5,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ContinueDetailText"
                                       Style="{StaticResource DashboardTileDetailStyle}" />
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="RecentAppsPanel" Orientation="Horizontal" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="AccountSection">
            <TextBlock x:Name="AccountHeading"
                       Text="ACCOUNT"
                       Margin="10,0,0,8"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MutedBrush}" />
            <ScrollViewer x:Name="AccountCarousel" Style="{StaticResource DashboardCarouselStyle}" Margin="0,0,0,22">
                <WrapPanel x:Name="AccountCarouselPanel" Orientation="Horizontal">
                <Button x:Name="MyProfileButton" Tag="my-profile" Style="{StaticResource DashboardTileStyle}" Click="MyProfile_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                <Button x:Name="UsersControllersButton" Tag="users-controllers" Style="{StaticResource DashboardTileStyle}" Click="UsersControllers_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                </WrapPanel>
            </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="AppsSection">
            <TextBlock x:Name="AppsHeading"
                       Text="APPS &amp; CONTENT"
                       Margin="10,0,0,8"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MutedBrush}" />
            <ScrollViewer x:Name="AppsCarousel" Style="{StaticResource DashboardCarouselStyle}" Margin="0,0,0,22">
                <WrapPanel x:Name="AppsCarouselPanel" Orientation="Horizontal">
                <Button x:Name="YourGamesButton" Tag="your-games" Style="{StaticResource DashboardTileStyle}" Click="YourGames_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick">
                    <StackPanel>
                        <TextBlock Text="Your Games" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock x:Name="GamesSummaryText" Text="Open your complete game library" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddGameButton" Tag="add-game" Style="{StaticResource DashboardTileStyle}" Click="AddGame_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                <Button x:Name="InstalledAppsButton" Tag="installed-apps" Style="{StaticResource DashboardTileStyle}" Click="InstalledApps_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick">
                    <StackPanel>
                        <TextBlock Text="Installed Apps" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Apps, emulators and individual games" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="StoreButton" Tag="grev-store" Style="{StaticResource DashboardTileStyle}" Click="Store_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick">
                    <StackPanel>
                        <TextBlock Text="Grev Store" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Browse supported apps" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="FilesButton" Tag="files" Style="{StaticResource DashboardTileStyle}" Click="Files_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick">
                    <StackPanel>
                        <TextBlock Text="Grev Files" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Browse local files and folders" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="GrevDadButton" Tag="grev-dad" Content="Grev.dad" Style="{StaticResource DashboardTileStyle}" Click="GrevDad_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                <Button x:Name="WebBrowserButton" Tag="web-browser" Content="Grev Web" Style="{StaticResource DashboardTileStyle}" Click="WebBrowser_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                </WrapPanel>
            </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="FriendsSection" Visibility="Collapsed" Margin="0,0,0,22">
                <Grid x:Name="FriendsHeading" Margin="10,0,10,8">
                    <TextBlock Text="FRIENDS" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="FriendsSummaryText" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </Grid>
                <ScrollViewer x:Name="FriendsCarousel" Style="{StaticResource DashboardCarouselStyle}">
                    <WrapPanel x:Name="FriendsPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="SystemSection">
            <TextBlock x:Name="SystemHeading"
                       Text="SYSTEM"
                       Margin="10,0,0,8"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MutedBrush}" />
            <ScrollViewer x:Name="SystemCarousel" Style="{StaticResource DashboardCarouselStyle}">
                <WrapPanel x:Name="SystemCarouselPanel" Orientation="Horizontal">
                <Button x:Name="RunningAppsButton"
                        Tag="running-apps"
                        Style="{StaticResource DashboardTileStyle}"
                        PreviewMouseRightButtonUp="DashboardTile_RightClick"
                        Click="RunningApps_Click">
                    <StackPanel>
                        <TextBlock Text="Running Apps" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock x:Name="RunningCountText"
                                   Text="0 active"
                                   Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ActivityCenterButton" Tag="activity-center" Style="{StaticResource DashboardTileStyle}" Click="ActivityCenter_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick">
                    <StackPanel>
                        <TextBlock Text="Activity Center" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock x:Name="ActivityCenterDetailText"
                                   Text="Notifications and downloads"
                                   Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="AppKillerButton" Tag="app-killer" Style="{StaticResource DashboardTileStyle}" Click="AppKiller_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick">
                    <StackPanel>
                        <TextBlock Text="App Killer" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Manage or force-close a stuck app" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsButton" Tag="settings" Style="{StaticResource DashboardTileStyle}" Click="Settings_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Grev Home and controller settings" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsAccountButton" Tag="settings-account" Style="{StaticResource DashboardTileStyle}" Click="SettingsPage_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                <Button x:Name="SettingsControllerButton" Tag="settings-controller" Style="{StaticResource DashboardTileStyle}" Click="SettingsPage_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                <Button x:Name="SettingsAudioButton" Tag="settings-audio" Style="{StaticResource DashboardTileStyle}" Click="SettingsPage_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                <Button x:Name="SettingsDisplayButton" Tag="settings-display" Style="{StaticResource DashboardTileStyle}" Click="SettingsPage_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                <Button x:Name="SettingsConnectionsButton" Tag="settings-connections" Style="{StaticResource DashboardTileStyle}" Click="SettingsPage_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                <Button x:Name="SettingsSystemButton" Tag="settings-system" Style="{StaticResource DashboardTileStyle}" Click="SettingsPage_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                <Button x:Name="SettingsGameScanButton" Tag="settings-game-scan" Style="{StaticResource DashboardTileStyle}" Click="SettingsPage_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                <Button x:Name="SettingsThemeButton" Tag="settings-theme" Style="{StaticResource DashboardTileStyle}" Click="SettingsPage_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                <Button x:Name="SettingsPowerButton" Tag="settings-power" Style="{StaticResource DashboardTileStyle}" Click="SettingsPage_Click" PreviewMouseRightButtonUp="DashboardTile_RightClick" />
                <Button x:Name="AdminConsoleButton"
                        Tag="admin-console"
                        Style="{StaticResource DashboardTileStyle}"
                        Visibility="Collapsed"
                        PreviewMouseRightButtonUp="DashboardTile_RightClick"
                        Click="AdminConsole_Click">
                    <StackPanel>
                        <TextBlock Text="Admin Console" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Machine, apps and account administration" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                </WrapPanel>
            </ScrollViewer>
            </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="DashboardStatusText"
                       Grid.Row="4"
                       Visibility="Collapsed"
                       Margin="10,18,10,0"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="13"
                       TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>

        <!-- Bottom dock: the System tiles as small round buttons, plus a clock (Switch, Wii). -->
        <Border x:Name="DockBar"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Visibility="Collapsed"
                Padding="48,14"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="DockLabelText" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource MutedBrush}" />
                <StackPanel x:Name="DockHost" Orientation="Horizontal" HorizontalAlignment="Center" />
                <TextBlock x:Name="DockClockText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="28" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
