<UserControl x:Class="GrevHome.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="DashboardTileStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="285" />
            <Setter Property="Height" Value="145" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="DashboardTileTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DashboardTileDetailStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  CanContentScroll="False">
        <StackPanel Margin="64,38,64,46">
            <StackPanel Margin="8,0,8,28">
                <TextBlock x:Name="WelcomeText"
                           Text="Welcome"
                           FontSize="38"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SessionUsersText"
                           Margin="0,6,0,0"
                           FontSize="15"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="APPS &amp; CONTENT"
                       Margin="10,0,0,8"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedBrush}" />
            <WrapPanel Margin="0,0,0,22">
                <Button Style="{StaticResource DashboardTileStyle}" Click="InstalledApps_Click">
                    <StackPanel>
                        <TextBlock Text="Installed Apps" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Your Grev Home library" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashboardTileStyle}" Click="Store_Click">
                    <StackPanel>
                        <TextBlock Text="Grev Store" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Browse supported apps" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashboardTileStyle}" Click="Files_Click">
                    <StackPanel>
                        <TextBlock Text="Files" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Browse local files and folders" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <TextBlock Text="SYSTEM"
                       Margin="10,0,0,8"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedBrush}" />
            <WrapPanel>
                <Button x:Name="RunningAppsButton"
                        Style="{StaticResource DashboardTileStyle}"
                        Click="RunningApps_Click">
                    <StackPanel>
                        <TextBlock Text="Running Apps" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock x:Name="RunningCountText"
                                   Text="0 active"
                                   Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashboardTileStyle}" Click="AppKiller_Click">
                    <StackPanel>
                        <TextBlock Text="App Killer" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Manage or force-close a stuck app" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashboardTileStyle}" Click="Settings_Click">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Grev Home and controller settings" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
                <Button x:Name="AdminConsoleButton"
                        Style="{StaticResource DashboardTileStyle}"
                        Visibility="Collapsed"
                        Click="AdminConsole_Click">
                    <StackPanel>
                        <TextBlock Text="Admin Console" Style="{StaticResource DashboardTileTitleStyle}" />
                        <TextBlock Text="Machine, apps and account administration" Style="{StaticResource DashboardTileDetailStyle}" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <TextBlock x:Name="DashboardStatusText"
                       Visibility="Collapsed"
                       Margin="10,18,10,0"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="13"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
