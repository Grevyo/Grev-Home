<UserControl x:Class="GrevHome.Views.ProfileTileEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GrevHome.Views" Focusable="True" PreviewKeyDown="PreviewKeyDown_Handler">
 <Grid Background="#0B0E14">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel Grid.Row="0" Margin="40,28,40,10">
   <TextBlock Text="Profile Tiles" FontSize="34" FontWeight="SemiBold" />
   <TextBlock x:Name="HintText" Margin="0,6,0,10" FontSize="16" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="Add a tile at the cursor: " VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}"/>
    <Button Content="Text" Margin="0,0,8,0" Tag="Text" Click="AddTile_Click"/>
    <Button Content="Link" Margin="0,0,8,0" Tag="Link" Click="AddTile_Click"/>
    <Button Content="Picture / GIF" Margin="0,0,8,0" Tag="Media" Click="AddTile_Click"/>
    <Button Content="Stat" Tag="Stat" Click="AddTile_Click"/>
   </StackPanel>
  </StackPanel>

  <Border Grid.Row="1" Margin="40,10" Padding="18" Background="#11151E" BorderBrush="#2B3344" BorderThickness="1" CornerRadius="16">
   <ScrollViewer x:Name="GridScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Canvas x:Name="GridCanvas" Background="Transparent" />
   </ScrollViewer>
  </Border>

  <Border x:Name="SettingsPanel" Grid.Row="1" Width="390" HorizontalAlignment="Right" VerticalAlignment="Stretch"
          Margin="0,22,54,22" Padding="22" Background="#F20B0E14" BorderBrush="#59677E" BorderThickness="1"
          CornerRadius="14" Visibility="Collapsed" Panel.ZIndex="30">
   <StackPanel>
    <TextBlock Text="TILE SETTINGS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
    <TextBlock x:Name="SettingsHeadingText" Margin="0,7,0,0" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="SettingsPositionText" Margin="0,4,0,14" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
    <Border Padding="14" Background="#151B25" BorderBrush="#2B3344" BorderThickness="1" CornerRadius="8">
     <StackPanel>
      <TextBlock x:Name="SettingsFieldText" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
      <TextBlock x:Name="SettingsValueText" Margin="0,7,0,0" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="SettingsDetailText" Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <TextBlock Margin="0,16,0,10" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
               Text="Controller: Up/Down chooses a setting, Left/Right changes list/range values, A edits or chooses media, B closes settings."/>
    <WrapPanel>
     <Button Content="Previous" Margin="0,0,8,8" Click="SettingsPrevious_Click"/>
     <Button Content="Change" Margin="0,0,8,8" Click="SettingsActivate_Click"/>
     <Button Content="Next" Margin="0,0,8,8" Click="SettingsNext_Click"/>
     <Button Content="Close" Margin="0,0,8,8" Click="SettingsClose_Click"/>
    </WrapPanel>
   </StackPanel>
  </Border>

  <Grid Grid.Row="2" Margin="40,0,40,26">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <TextBlock x:Name="PromptText" Grid.Column="0" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Content="Edit Tile" Margin="0,0,10,0" Click="EditTile_Click" IsTabStop="False"/>
    <Button Content="Duplicate Tile" Margin="0,0,10,0" Click="DuplicateTile_Click" IsTabStop="False"/>
    <Button Content="Remove Tile" Margin="0,0,10,0" Click="RemoveTile_Click" IsTabStop="False"/>
    <Button Content="Save" Margin="0,0,10,0" Click="Save_Click" IsTabStop="False"/>
    <Button Content="Back" Click="Back_Click" IsTabStop="False"/>
   </StackPanel>
  </Grid>

  <local:ControllerQwertyKeyboard x:Name="KeyboardOverlay" Grid.RowSpan="3" Panel.ZIndex="100"/>
 </Grid>
</UserControl>
