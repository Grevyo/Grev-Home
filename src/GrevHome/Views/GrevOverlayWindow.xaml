<Window x:Class="GrevHome.Views.GrevOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grev Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="White"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="#B8000000">
        <Border Width="1040"
                MaxHeight="820"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FA171B25"
                BorderBrush="#7180A3"
                BorderThickness="2"
                CornerRadius="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText"
                           Grid.Row="0"
                           Text="GREV OVERLAY"
                           Foreground="White"
                           FontSize="32"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="SubtitleText"
                           Grid.Row="1"
                           Margin="0,7,0,18"
                           Foreground="#E2E7F0"
                           FontSize="15"
                           TextWrapping="Wrap" />

                <ScrollViewer x:Name="ContentScrollViewer"
                              Grid.Row="2"
                              MaxHeight="520"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly"
                              CanContentScroll="False">
                    <StackPanel x:Name="ActionPanel" />
                </ScrollViewer>

                <UniformGrid x:Name="GuideActionPanel"
                             Grid.Row="3"
                             Rows="1"
                             Margin="-5,18,-5,0"
                             Visibility="Collapsed" />

                <TextBlock x:Name="HintText"
                           Grid.Row="4"
                           Margin="0,16,0,0"
                           Foreground="#EEF1F7"
                           Text="A Select   •   B Back / Resume"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>
