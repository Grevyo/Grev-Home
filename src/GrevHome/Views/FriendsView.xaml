<UserControl x:Class="GrevHome.Views.FriendsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="72,38">
   <TextBlock Text="Friends" FontSize="40" FontWeight="SemiBold"/>
   <TextBlock x:Name="ContextText" Margin="0,6,0,22" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
   <WrapPanel x:Name="FriendsPanel"/>
   <TextBlock x:Name="EmptyText" Text="No friends to show yet." FontSize="18" Foreground="{StaticResource MutedBrush}" Margin="8,20"/>
   <Button Content="Refresh Friends" Width="220" Margin="8,20,8,8" Click="Refresh_Click"/>
   <Button Content="Back" Width="140" Margin="8" Click="Back_Click"/>
   <TextBlock x:Name="StatusText" Margin="8" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
