<UserControl x:Class="GrevHome.Views.FriendsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GrevHome.Views" Focusable="False">
 <Grid>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="72,38">
    <TextBlock Text="Friends" FontSize="40" FontWeight="SemiBold"/>
    <TextBlock x:Name="ContextText" Margin="0,6,0,18" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
    <Border Padding="18" Background="{StaticResource SurfaceBrush}" BorderBrush="#354158" BorderThickness="1">
     <StackPanel>
      <TextBlock Text="YOUR FRIEND CODE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
      <TextBlock x:Name="FriendCodeText" Margin="0,5,0,10" FontSize="26" FontWeight="Bold"/>
      <TextBlock Text="This permanent code belongs to your Grev.dad account. It stays the same on another PC or after reinstalling." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,10,0,0">
       <Button Content="Copy My Code" Width="180" Height="48" Margin="3" Click="CopyCode_Click"/>
       <Button Content="Add Friend by Code" Width="210" Height="48" Margin="3" Click="OpenFriendCodeKeyboard_Click"/>
      </WrapPanel>
     </StackPanel>
    </Border>
    <TextBlock Text="REQUESTS" Margin="0,22,0,8" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
    <WrapPanel x:Name="RequestsPanel"/>
    <TextBlock x:Name="NoRequestsText" Text="No pending friend requests." Margin="8" Foreground="{StaticResource MutedBrush}"/>
    <TextBlock Text="YOUR FRIENDS" Margin="0,22,0,8" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
    <WrapPanel x:Name="FriendsPanel"/>
    <TextBlock x:Name="EmptyText" Text="No friends yet. Add someone using their permanent friend code." FontSize="18" Foreground="{StaticResource MutedBrush}" Margin="8,20"/>
    <WrapPanel Margin="5,18,0,0"><Button Content="Refresh" Width="160" Margin="3" Click="Refresh_Click"/><Button Content="Back" Width="140" Margin="3" Click="Back_Click"/></WrapPanel>
    <TextBlock x:Name="StatusText" Margin="8" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
   </StackPanel>
  </ScrollViewer>
  <local:ControllerQwertyKeyboard x:Name="FriendCodeKeyboard" Panel.ZIndex="200"/>
 </Grid>
</UserControl>
