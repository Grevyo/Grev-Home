<UserControl x:Class="GrevHome.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="72,42" MaxWidth="1040">
            <TextBlock Text="Profile" FontSize="40" FontWeight="SemiBold" />
            <TextBlock Text="Local Grev Home identity, role and profile information." Margin="0,6,0,24" FontSize="16" Foreground="{StaticResource MutedBrush}" />

            <Border Background="#11151E" BorderBrush="#2B3344" BorderThickness="1" CornerRadius="16" Padding="28">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="100" Height="100" CornerRadius="50" Background="#1F283A" Margin="0,0,22,0" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                <TextBlock x:Name="AvatarText" Text="G" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DisplayNameText" Text="Display Name" FontSize="34" FontWeight="SemiBold" />
                            <TextBlock x:Name="UsernameText" Margin="0,6,0,0" FontSize="18" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="RoleText" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                            <TextBlock x:Name="SessionText" Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#2B3344" Margin="0,24,0,22" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="GrevID" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="GrevIdText" Margin="0,5,0,16" FontSize="17" TextWrapping="Wrap" />
                            <TextBlock Text="Created" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="CreatedText" Margin="0,5,0,0" FontSize="17" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ROLE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="RoleDescriptionText" Margin="0,5,0,16" FontSize="14" TextWrapping="Wrap" />
                            <TextBlock Text="CURRENT PERMISSIONS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="PermissionsText" Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Button x:Name="EditProfileButton" Content="Edit Profile" Width="170" Height="52" Margin="0,28,0,0" HorizontalAlignment="Left" Click="EditProfile_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
