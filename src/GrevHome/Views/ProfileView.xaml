<UserControl x:Class="GrevHome.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="ProfileSectionCard" TargetType="Border">
            <Setter Property="Background" Value="#11151E" />
            <Setter Property="BorderBrush" Value="#252D3B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style x:Key="ProfileEyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="ProfileStatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ProfileRootPanel" Margin="54,26,54,48" MaxWidth="1240">
            <Grid Margin="4,0,4,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PROFILE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Your Grev Home identity" Margin="0,3,0,0" FontSize="30" FontWeight="SemiBold" />
                </StackPanel>
                <Button x:Name="EditProfileButton"
                        Grid.Column="1"
                        Content="✎  Edit Profile"
                        MinWidth="154"
                        Height="46"
                        Margin="18,0,0,0"
                        VerticalAlignment="Center"
                        Click="EditProfile_Click" />
            </Grid>

            <Border x:Name="ProfileHeaderCard"
                    Background="#10151F"
                    BorderBrush="{StaticResource GuestRoleBrush}"
                    BorderThickness="2"
                    CornerRadius="0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="142" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#243451" Offset="0" />
                                <GradientStop Color="#171D2B" Offset="0.48" />
                                <GradientStop Color="#0A0E15" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Rectangle Width="310"
                                   Height="142"
                                   HorizontalAlignment="Right"
                                   Fill="#14223834"
                                   Margin="0,0,0,0" />
                        <Rectangle Width="170"
                                   Height="142"
                                   HorizontalAlignment="Right"
                                   Fill="#102D405E"
                                   Margin="0,0,310,0" />
                        <TextBlock Text="GREV HOME"
                                   Margin="28,24,0,0"
                                   VerticalAlignment="Top"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#A8B5C9"
                                   Opacity="0.72" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="28,-48,28,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ProfileAvatarBorder"
                                Width="142"
                                Height="142"
                                CornerRadius="0"
                                Background="#1F283A"
                                BorderBrush="{StaticResource GuestRoleBrush}"
                                BorderThickness="4"
                                Margin="0,0,24,0"
                                VerticalAlignment="Top"
                                ClipToBounds="True">
                            <Grid>
                                <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                <TextBlock x:Name="AvatarText"
                                           Text="G"
                                           FontSize="46"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="0,54,20,0" VerticalAlignment="Top">
                            <TextBlock x:Name="DisplayNameText"
                                       Text="Display Name"
                                       FontSize="36"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <WrapPanel Margin="0,5,0,0">
                                <TextBlock x:Name="UsernameText" FontSize="16" Foreground="{StaticResource MutedBrush}" Margin="0,0,14,0" />
                                <Border Padding="9,3" CornerRadius="0" Background="#192232" Margin="0,0,8,0">
                                    <TextBlock x:Name="RoleText" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GuestRoleBrush}" />
                                </Border>
                                <TextBlock x:Name="GrevDadLinkedText"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </WrapPanel>
                            <TextBlock x:Name="StatusMessageText"
                                       Margin="0,10,0,0"
                                       MaxWidth="690"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="BioText"
                                       Margin="0,7,0,0"
                                       MaxWidth="720"
                                       FontSize="14"
                                       LineHeight="21"
                                       TextWrapping="Wrap"
                                       Foreground="#CCD3DF" />
                            <TextBlock x:Name="SessionText"
                                       Margin="0,10,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>

                        <Border x:Name="LevelBadgeBorder"
                                Grid.Column="2"
                                Margin="18,62,0,0"
                                Padding="18,12"
                                MinWidth="150"
                                VerticalAlignment="Top"
                                Background="#B3090C12"
                                BorderBrush="#334058"
                                BorderThickness="2"
                                CornerRadius="0">
                            <StackPanel>
                                <TextBlock Text="GREV LEVEL" HorizontalAlignment="Center" Style="{StaticResource ProfileEyebrow}" />
                                <TextBlock x:Name="LevelText"
                                           Text="LEVEL 1"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource ProfileSectionCard}" Margin="0,16,0,0" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
                        <TextBlock Text="LEVEL" Style="{StaticResource ProfileEyebrow}" />
                        <TextBlock x:Name="LevelNumberText" Text="1" FontSize="44" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="PROGRESSION" Style="{StaticResource ProfileEyebrow}" />
                        <ProgressBar x:Name="LevelProgressBar" Height="12" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="XpText" Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="26,0,0,0" VerticalAlignment="Center" MinWidth="220">
                        <TextBlock Text="LAST ACTIVITY" Style="{StaticResource ProfileEyebrow}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="LastActivityText" Text="No tracked activity yet" Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock x:Name="ActivityStatusText" Margin="0,4,0,0" MaxWidth="300" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="0,12,0,0">
                <Border Style="{StaticResource ProfileSectionCard}" Margin="0,0,6,0" Padding="18,15">
                    <StackPanel>
                        <TextBlock Text="PLAYTIME" Style="{StaticResource ProfileEyebrow}" />
                        <TextBlock x:Name="TotalTimeText" Text="0m" Style="{StaticResource ProfileStatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ProfileSectionCard}" Margin="6,0" Padding="18,15">
                    <StackPanel>
                        <TextBlock Text="SESSIONS" Style="{StaticResource ProfileEyebrow}" />
                        <TextBlock x:Name="SessionsText" Text="0" Style="{StaticResource ProfileStatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ProfileSectionCard}" Margin="6,0" Padding="18,15">
                    <StackPanel>
                        <TextBlock Text="APPS PLAYED" Style="{StaticResource ProfileEyebrow}" />
                        <TextBlock x:Name="AppsPlayedText" Text="0" Style="{StaticResource ProfileStatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ProfileSectionCard}" Margin="6,0,0,0" Padding="18,15">
                    <StackPanel>
                        <TextBlock Text="RUNNING NOW" Style="{StaticResource ProfileEyebrow}" />
                        <TextBlock x:Name="ActiveSessionsText" Text="0" Style="{StaticResource ProfileStatValue}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*" />
                    <ColumnDefinition Width="0.88*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ProfileSectionCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="RECENTLY PLAYED" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Your latest Grev Home activity" Margin="0,3,0,8" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="NoRecentActivityText" Text="No Grev Home activity yet." Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" />
                        <StackPanel x:Name="RecentActivityPanel" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ProfileSectionCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="TOP PLAYED" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Your most-played managed apps" Margin="0,3,0,8" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="NoTopAppsText" Text="No completed Grev Home playtime yet." Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" />
                        <StackPanel x:Name="TopAppsPanel" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource ProfileSectionCard}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MILESTONES" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="A showcase earned from real Grev Home activity" Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="MilestoneSummaryText" Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                    <WrapPanel x:Name="MilestonesPanel" Margin="-4,12,-4,-4" />
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ProfileSectionCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="CONNECTED GAMING STATS" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="External gaming providers connected to this profile" Margin="0,3,0,8" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        <StackPanel x:Name="SourcesPanel" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ProfileSectionCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PROFILE DETAILS" FontSize="18" FontWeight="SemiBold" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="GREV ID" Style="{StaticResource ProfileEyebrow}" />
                                <TextBlock x:Name="GrevIdText" Margin="0,4,0,14" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Text="MEMBER SINCE" Style="{StaticResource ProfileEyebrow}" />
                                <TextBlock x:Name="CreatedText" Margin="0,4,0,0" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ROLE &amp; ACCESS" Style="{StaticResource ProfileEyebrow}" />
                                <TextBlock x:Name="RoleDescriptionText" Margin="0,4,0,8" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock x:Name="PermissionsText" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
