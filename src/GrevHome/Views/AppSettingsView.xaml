<UserControl x:Class="GrevHome.Views.AppSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="72,38" MaxWidth="1180">
            <TextBlock Text="App Settings" FontSize="40" FontWeight="SemiBold" />
            <TextBlock x:Name="AppIdentityText"
                       Margin="0,6,0,22"
                       FontSize="15"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />

            <Border Padding="24"
                    Background="#11151E"
                    BorderBrush="#2B3344"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <TextBlock x:Name="AppNameText" Text="App" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock x:Name="NativeSupportText"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Padding="24"
                    Background="#11151E"
                    BorderBrush="#2B3344"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="CONTROLLER PROFILE"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="ControllerSourceText"
                               Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="#D7DCE7"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Every Grev Home app uses this same controller layout. Leave mappings as Unassigned when an app already handles controllers itself. App packages can supply defaults and each GrevID can override them here."
                               Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />

                    <Button x:Name="ControllerProfileToggleButton"
                            Width="260"
                            Height="48"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Click="ControllerProfileToggle_Click" />

                    <Grid Margin="0,18,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CONTROL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="1" Text="MAPPING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="2" Grid.ColumnSpan="3" Text="CHANGE" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    </Grid>

                    <StackPanel x:Name="MappingsPanel" />

                    <TextBlock Text="The mapping catalogue is intentionally app-agnostic: keyboard navigation, common shortcuts, Grev on-screen keyboard, mouse modes and media controls. Future packages such as Discord can ship a populated default using this same layout."
                               Margin="0,14,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,18,0,0">
                <Button x:Name="SaveButton" Content="Save App Settings" Width="210" Height="52" Margin="0,0,10,10" Click="Save_Click" />
                <Button x:Name="ResetButton" Content="Reset to App Default" Width="220" Height="52" Margin="0,0,10,10" Click="Reset_Click" />
                <Button Content="Back" Width="130" Height="52" Margin="0,0,10,10" Click="Back_Click" />
            </WrapPanel>

            <Border Margin="0,4,0,0"
                    Padding="18"
                    Background="#11151E"
                    BorderBrush="#2B3344"
                    BorderThickness="1"
                    CornerRadius="12">
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
