<UserControl x:Class="GrevHome.Views.AppSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="WrappedSettingsButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSectionHeaderStyle"
               TargetType="Button"
               BasedOn="{StaticResource WrappedSettingsButtonStyle}">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Left"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="72,38" MaxWidth="1180">
            <TextBlock Text="App Settings" FontSize="40" FontWeight="SemiBold" />
            <TextBlock x:Name="AppIdentityText"
                       Margin="0,6,0,22"
                       FontSize="15"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />

            <Border Padding="12"
                    Background="#11151E"
                    BorderBrush="#2B3344"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <Button x:Name="GeneralSectionToggleButton"
                            Style="{StaticResource SettingsSectionHeaderStyle}"
                            Click="GeneralSectionToggle_Click" />
                    <StackPanel x:Name="GeneralSectionPanel" Margin="12,12,12,12">
                        <TextBlock x:Name="AppNameText"
                                   Text="App"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="NativeSupportText"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Padding="12"
                    Background="#11151E"
                    BorderBrush="#2B3344"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <Button x:Name="ControllerSectionToggleButton"
                            Style="{StaticResource SettingsSectionHeaderStyle}"
                            Click="ControllerSectionToggle_Click" />

                    <StackPanel x:Name="ControllerSectionPanel" Margin="12,12,12,12">
                        <TextBlock x:Name="ControllerSourceText"
                                   FontSize="14"
                                   Foreground="#D7DCE7"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Every Grev Home app uses this same controller layout. Leave mappings as Unassigned when an app already handles controllers itself. App packages can supply defaults and each GrevID can override them here."
                                   Margin="0,7,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />

                        <Button x:Name="ControllerProfileToggleButton"
                                MinWidth="280"
                                MaxWidth="420"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource WrappedSettingsButtonStyle}"
                                Click="ControllerProfileToggle_Click" />

                        <Grid Margin="0,18,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CONTROL"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1"
                                       Margin="12,0"
                                       Text="MAPPING"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2"
                                       Grid.ColumnSpan="3"
                                       Text="CHANGE"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel x:Name="MappingsPanel" />

                        <TextBlock Text="The mapping catalogue is intentionally app-agnostic: keyboard navigation, common shortcuts, Grev on-screen keyboard, mouse modes and media controls. Future packages such as Discord can ship a populated default using this same layout."
                                   Margin="0,14,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,18,0,0">
                <Button x:Name="SaveButton"
                        Content="Save App Settings"
                        MinWidth="210"
                        Margin="0,0,10,10"
                        Style="{StaticResource WrappedSettingsButtonStyle}"
                        Click="Save_Click" />
                <Button x:Name="ResetButton"
                        Content="Reset to App Default"
                        MinWidth="220"
                        Margin="0,0,10,10"
                        Style="{StaticResource WrappedSettingsButtonStyle}"
                        Click="Reset_Click" />
                <Button Content="Back"
                        MinWidth="130"
                        Margin="0,0,10,10"
                        Style="{StaticResource WrappedSettingsButtonStyle}"
                        Click="Back_Click" />
            </WrapPanel>

            <Border Margin="0,4,0,0"
                    Padding="18"
                    Background="#11151E"
                    BorderBrush="#2B3344"
                    BorderThickness="1"
                    CornerRadius="12">
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
