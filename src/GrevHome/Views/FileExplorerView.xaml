<UserControl x:Class="GrevHome.Views.FileExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="54,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Files" FontSize="38" FontWeight="SemiBold" />
                <TextBlock x:Name="LocationText"
                           Text="Home"
                           Margin="0,5,0,0"
                           FontSize="15"
                           Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Content="Back to Dashboard"
                    Width="180"
                    Height="48"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="BackToDashboard_Click" />
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <Button Content="Home" Width="105" Height="48" Margin="0,0,8,8" Click="Home_Click" />
            <Button x:Name="UpButton" Content="Up" Width="95" Height="48" Margin="0,0,8,8" Click="Up_Click" />
            <Button Content="Refresh" Width="110" Height="48" Margin="0,0,8,8" Click="Refresh_Click" />
            <Button x:Name="NewFolderButton" Content="New Folder" Width="135" Height="48" Margin="0,0,8,8" Click="NewFolder_Click" />
            <Button x:Name="PasteButton" Content="Paste Here" Width="135" Height="48" Margin="0,0,8,8" Click="Paste_Click" />
            <Button x:Name="CancelTransferButton" Content="Cancel Copy/Move" Width="170" Height="48" Margin="0,0,8,8" Click="CancelTransfer_Click" />
        </WrapPanel>

        <Border Grid.Row="2"
                Background="#A9151923"
                BorderBrush="#343D51"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="EmptyText"
                               Text="This folder is empty."
                               Visibility="Collapsed"
                               Margin="8"
                               Foreground="{StaticResource MutedBrush}" />
                    <StackPanel x:Name="EntriesPanel" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <Border Background="#11151E"
                    BorderBrush="#2B3344"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SelectedNameText" Text="No item selected" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedDetailText"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Choose an item, then use the actions on the right." />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="OpenButton" Content="Open" Width="90" Height="44" Margin="4" Click="Open_Click" IsEnabled="False" />
                        <Button x:Name="CopyButton" Content="Copy" Width="90" Height="44" Margin="4" Click="Copy_Click" IsEnabled="False" />
                        <Button x:Name="MoveButton" Content="Move" Width="90" Height="44" Margin="4" Click="Move_Click" IsEnabled="False" />
                        <Button x:Name="RenameButton" Content="Rename" Width="100" Height="44" Margin="4" Click="Rename_Click" IsEnabled="False" />
                        <Button x:Name="DeleteButton" Content="Delete" Width="95" Height="44" Margin="4" Click="Delete_Click" IsEnabled="False" />
                    </WrapPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="TransferText"
                       Margin="4,8,0,0"
                       Foreground="{StaticResource AccentBrush}"
                       Visibility="Collapsed"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText"
                       Margin="4,5,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       Text="A selects an item/action. B goes back through folders, then returns to Dashboard."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="EditorOverlay"
                Grid.RowSpan="4"
                Visibility="Collapsed"
                Background="#F0080B11"
                CornerRadius="14"
                Padding="36"
                Panel.ZIndex="10">
            <StackPanel Width="820" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="EditorTitleText" Text="Name" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBox x:Name="NameTextBox"
                         Height="54"
                         Margin="0,18,0,10"
                         Padding="14,8"
                         FontSize="21"
                         MaxLength="120" />
                <TextBlock x:Name="EditorStatusText"
                           Margin="0,0,0,12"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Use the controller keyboard or a physical keyboard." />
                <UniformGrid x:Name="NameKeyboard" Columns="10" />
                <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="CaseButton" Content="Aa" Width="90" Height="48" Margin="4" Click="ToggleCase_Click" />
                    <Button Content="Space" Width="170" Height="48" Margin="4" Click="NameSpace_Click" />
                    <Button Content="Backspace" Width="145" Height="48" Margin="4" Click="NameBackspace_Click" />
                    <Button Content="Save" Width="120" Height="48" Margin="4" Click="SaveName_Click" />
                    <Button Content="Cancel" Width="120" Height="48" Margin="4" Click="CancelEditor_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border x:Name="DeleteOverlay"
                Grid.RowSpan="4"
                Visibility="Collapsed"
                Background="#F0080B11"
                CornerRadius="14"
                Padding="36"
                Panel.ZIndex="11">
            <StackPanel Width="650" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Delete this item?" FontSize="31" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="DeleteTargetText"
                           Margin="0,14,0,0"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Text="Folders are deleted recursively. This does not use the Recycle Bin in 0.8."
                           Margin="0,10,0,20"
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="CONFIRM DELETE" Width="190" Height="54" Margin="6" Click="ConfirmDelete_Click" />
                    <Button Content="Cancel" Width="140" Height="54" Margin="6" Click="CancelDelete_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
