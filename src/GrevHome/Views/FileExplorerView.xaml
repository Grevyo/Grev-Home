<UserControl x:Class="GrevHome.Views.FileExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="54,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Files" FontSize="38" FontWeight="SemiBold" />
                <TextBlock x:Name="LocationText"
                           Text="Home"
                           Margin="0,5,0,0"
                           FontSize="15"
                           Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Content="Back to Dashboard"
                    Width="180"
                    Height="48"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="BackToDashboard_Click" />
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <Button Content="Home" Width="105" Height="48" Margin="0,0,8,8" Click="Home_Click" />
            <Button x:Name="UpButton" Content="Up" Width="95" Height="48" Margin="0,0,8,8" Click="Up_Click" />
            <Button Content="Refresh" Width="110" Height="48" Margin="0,0,8,8" Click="Refresh_Click" />
            <Button x:Name="NewFolderButton" Content="New Folder" Width="135" Height="48" Margin="0,0,8,8" Click="NewFolder_Click" />
            <Button x:Name="PasteButton" Content="Paste Here" Width="135" Height="48" Margin="0,0,8,8" Click="Paste_Click" />
            <Button x:Name="CancelTransferButton" Content="Cancel Copy/Move" Width="170" Height="48" Margin="0,0,8,8" Click="CancelTransfer_Click" />
        </WrapPanel>

        <Border Grid.Row="2"
                Background="#A9151923"
                BorderBrush="#343D51"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="EmptyText"
                               Text="This folder is empty."
                               Visibility="Collapsed"
                               Margin="8"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="EntriesPanel" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <Border Background="#11151E"
                    BorderBrush="#2B3344"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SelectedNameText"
                                   Text="No item selected"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectedDetailText"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Choose an item, then use the actions on the right."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="OpenButton" Content="Open" Width="90" Height="44" Margin="4" Click="Open_Click" IsEnabled="False" />
                        <Button x:Name="CopyButton" Content="Copy" Width="90" Height="44" Margin="4" Click="Copy_Click" IsEnabled="False" />
                        <Button x:Name="MoveButton" Content="Move" Width="90" Height="44" Margin="4" Click="Move_Click" IsEnabled="False" />
                        <Button x:Name="RenameButton" Content="Rename" Width="100" Height="44" Margin="4" Click="Rename_Click" IsEnabled="False" />
                        <Button x:Name="DeleteButton" Content="Delete" Width="95" Height="44" Margin="4" Click="Delete_Click" IsEnabled="False" />
                    </WrapPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="TransferText"
                       Margin="4,8,0,0"
                       Foreground="{StaticResource AccentBrush}"
                       Visibility="Collapsed"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText"
                       Margin="4,5,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       Text="A selects an item/action. B goes back through folders, then returns to Dashboard."
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Rename/create is a bounded shell modal. The keyboard may scroll independently while
             its command row remains fixed and visible. -->
        <Border x:Name="EditorOverlay"
                Grid.RowSpan="4"
                Visibility="Collapsed"
                Background="#E6080B11"
                Panel.ZIndex="10">
            <Border MinWidth="620"
                    MaxWidth="980"
                    MaxHeight="760"
                    Margin="32"
                    Style="{StaticResource ShellModalCardStyle}">
                <Grid KeyboardNavigation.DirectionalNavigation="Contained">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock x:Name="EditorTitleText"
                                   Text="Name"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="NameTextBox"
                                 MinHeight="54"
                                 Height="Auto"
                                 Margin="0,16,0,10"
                                 Padding="14,8"
                                 FontSize="21"
                                 MaxLength="120" />
                        <TextBlock x:Name="EditorStatusText"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Use the controller keyboard or a physical keyboard."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="430"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <UniformGrid x:Name="NameKeyboard" Columns="10" />
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Margin="0,14,0,0"
                            Padding="0,14,0,0"
                            BorderBrush="#2B3344"
                            BorderThickness="0,1,0,0">
                        <WrapPanel HorizontalAlignment="Center">
                            <Button x:Name="CaseButton"
                                    Content="Aa"
                                    MinWidth="90"
                                    Style="{StaticResource ShellModalActionButtonStyle}"
                                    Click="ToggleCase_Click" />
                            <Button Content="Space"
                                    MinWidth="170"
                                    Style="{StaticResource ShellModalActionButtonStyle}"
                                    Click="NameSpace_Click" />
                            <Button Content="Backspace"
                                    MinWidth="145"
                                    Style="{StaticResource ShellModalActionButtonStyle}"
                                    Click="NameBackspace_Click" />
                            <Button Content="Save"
                                    MinWidth="120"
                                    Style="{StaticResource ShellModalActionButtonStyle}"
                                    Click="SaveName_Click" />
                            <Button x:Name="EditorCancelButton"
                                    Content="Cancel"
                                    MinWidth="120"
                                    Style="{StaticResource ShellModalActionButtonStyle}"
                                    Click="CancelEditor_Click" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- Delete is intentionally safer: information scrolls independently and Cancel is the
             first controller target in the fixed footer. -->
        <Border x:Name="DeleteOverlay"
                Grid.RowSpan="4"
                Visibility="Collapsed"
                Background="#E6080B11"
                Panel.ZIndex="11">
            <Border MinWidth="520"
                    MaxWidth="720"
                    MaxHeight="620"
                    Margin="32"
                    Style="{StaticResource ShellModalCardStyle}">
                <Grid KeyboardNavigation.DirectionalNavigation="Contained">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  MaxHeight="430"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Delete this item?"
                                       FontSize="31"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="DeleteTargetText"
                                       Margin="0,14,0,0"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Folders are deleted recursively. This does not use the Recycle Bin."
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Margin="0,18,0,0"
                            Padding="0,14,0,0"
                            BorderBrush="#2B3344"
                            BorderThickness="0,1,0,0">
                        <WrapPanel HorizontalAlignment="Center">
                            <Button x:Name="DeleteCancelButton"
                                    Content="Cancel"
                                    MinWidth="150"
                                    Style="{StaticResource ShellModalActionButtonStyle}"
                                    Click="CancelDelete_Click" />
                            <Button Content="CONFIRM DELETE"
                                    MinWidth="210"
                                    Style="{StaticResource ShellModalDangerActionButtonStyle}"
                                    Click="ConfirmDelete_Click" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
