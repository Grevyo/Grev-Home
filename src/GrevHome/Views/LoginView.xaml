<UserControl x:Class="GrevHome.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="72,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeadingText"
                       Text="Who's playing?"
                       HorizontalAlignment="Center"
                       FontSize="46"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="SubheadingText"
                       Text="Choose your profile to enter Grev Home."
                       HorizontalAlignment="Center"
                       Margin="0,8,0,22"
                       FontSize="16"
                       Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="1120" HorizontalAlignment="Center">
                <TextBlock Text="PROFILES" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <WrapPanel x:Name="ProfilesPanel" Margin="0,8,0,12" />
                <TextBlock x:Name="NoProfilesText"
                           Text="No accounts yet. Create the first Grev Home account below."
                           Margin="0,4,0,10"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button x:Name="CreateAccountButton"
                    Content="＋ Create Account"
                    Width="240"
                    Height="60"
                    Margin="6"
                    Click="CreateProfile_Click" />
        </StackPanel>
    </Grid>
</UserControl>
