<UserControl x:Class="GrevHome.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="72,44">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Who's playing?"
                       HorizontalAlignment="Center"
                       FontSize="48"
                       FontWeight="SemiBold" />
            <TextBlock Text="Grev Home always starts with an account session."
                       HorizontalAlignment="Center"
                       Margin="0,10,0,34"
                       FontSize="17"
                       Foreground="{StaticResource MutedBrush}" />

            <WrapPanel HorizontalAlignment="Center">
                <Button x:Name="LocalAccountButton"
                        Width="260"
                        Height="170"
                        Margin="10"
                        Click="LocalAccount_Click">
                    <StackPanel>
                        <TextBlock Text="LOCAL" HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Local Profile" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="Offline account" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Button>

                <Button Width="260"
                        Height="170"
                        Margin="10"
                        Click="GuestAccount_Click">
                    <StackPanel>
                        <TextBlock Text="GUEST" HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Guest" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="Temporary session" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Button>

                <Button Width="260"
                        Height="170"
                        Margin="10"
                        IsEnabled="False">
                    <StackPanel>
                        <TextBlock Text="ONLINE" HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Grev.dad" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="Coming later" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="0.1 uses placeholder local/guest identities. Persistent profile creation and multi-user controller assignment come next."
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="13" />
    </Grid>
</UserControl>
