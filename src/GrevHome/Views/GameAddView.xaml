<UserControl x:Class="GrevHome.Views.GameAddView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="72,38" MaxWidth="920">
            <TextBlock Text="ADD GAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Add a game to this player's library" Margin="0,4,0,0" FontSize="36" FontWeight="SemiBold" />
            <TextBlock x:Name="OwnerText"
                       Margin="0,7,0,24"
                       FontSize="14"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />

            <Border Padding="22"
                    Background="#11151E"
                    BorderBrush="#2B3344"
                    BorderThickness="1"
                    CornerRadius="0">
                <StackPanel>
                    <TextBlock Text="CONSOLE / PLATFORM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="The platform tells Grev Home which emulator should open the game."
                               Margin="0,5,0,10"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />

                    <Button x:Name="PlatformButton"
                            Content="PlayStation 2  ▾"
                            Width="280"
                            Height="54"
                            HorizontalAlignment="Left"
                            Click="Platform_Click" />
                    <StackPanel x:Name="PlatformChoicesPanel" Visibility="Collapsed" Margin="0,6,0,0">
                        <Button Content="PlayStation 2"
                                Tag="PlayStation2"
                                Width="280"
                                Height="50"
                                HorizontalAlignment="Left"
                                Click="PlatformChoice_Click" />
                    </StackPanel>

                    <Border Margin="0,22,0,20" BorderBrush="#2B3344" BorderThickness="0,1,0,0" />

                    <TextBlock Text="GAME FILE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="PlatformHelpText"
                               Margin="0,5,0,12"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                    <Button Content="Choose Game File"
                            Width="230"
                            Height="54"
                            HorizontalAlignment="Left"
                            Click="ChooseFile_Click" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText"
                       Margin="4,14,4,0"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />

            <Button Content="Back"
                    Width="160"
                    Height="50"
                    Margin="0,22,0,0"
                    HorizontalAlignment="Left"
                    Click="Back_Click" />
        </StackPanel>
    </ScrollViewer>
</UserControl>