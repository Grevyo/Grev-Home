<UserControl x:Class="GrevHome.Views.ControllerQwertyKeyboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Focusable="False">
    <Grid Background="#D9090C12" KeyboardNavigation.DirectionalNavigation="Cycle">
        <Border Width="1080" MaxWidth="1080" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111722" BorderBrush="#3A4864" BorderThickness="1" CornerRadius="18">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Enter text" HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold" />
                <Border Margin="0,16,0,20" Padding="16,12" Background="#090C12" BorderBrush="#2B3344" BorderThickness="1" CornerRadius="10">
                    <TextBlock x:Name="ValueText" MinHeight="32" FontSize="22" TextWrapping="Wrap" TextAlignment="Center" />
                </Border>
                <StackPanel x:Name="KeyboardRows" />
                <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button x:Name="ShiftButton" Content="Shift" Width="120" Height="54" Margin="4" Click="Shift_Click" />
                    <Button Content="Space" Width="330" Height="54" Margin="4" Click="Space_Click" />
                    <Button Content="⌫ Backspace" Width="160" Height="54" Margin="4" Click="Backspace_Click" />
                    <Button Content="Clear" Width="110" Height="54" Margin="4" Click="Clear_Click" />
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Cancel" Width="150" Height="56" Margin="5" Click="Cancel_Click" />
                    <Button Content="Done" Width="190" Height="56" Margin="5" Click="Done_Click" />
                </WrapPanel>
                <TextBlock Text="D-pad / stick to move  •  A to type  •  Shift changes case  •  B cancels" HorizontalAlignment="Center" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
