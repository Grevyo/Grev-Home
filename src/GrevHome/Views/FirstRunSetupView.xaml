<UserControl x:Class="GrevHome.Views.FirstRunSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GrevHome.Views"
             Focusable="False">
    <Grid>
        <Grid x:Name="SetupContent">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="72,42" HorizontalAlignment="Center" Width="960">
                    <TextBlock Text="Welcome to Grev Home"
                               HorizontalAlignment="Center"
                               FontSize="42"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Choose where Grev Home should keep games and BIOS files. Your primary Games folder is used by Grev-managed installers; add extra Games locations if your library spans more than one drive. BIOS remains one shared machine-wide location."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,10,0,34"
                               FontSize="16"
                               Foreground="{StaticResource MutedBrush}" />

                    <TextBlock Text="PRIMARY GAMES FOLDER" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Default location for installed games and emulator-managed content." Margin="0,2,0,8" Foreground="{StaticResource MutedBrush}" />
                    <TextBox x:Name="GamesPathText"
                             Height="52"
                             Padding="14,8"
                             FontSize="17"
                             IsReadOnly="True"
                             IsTabStop="False"
                             Margin="0,0,0,10" />
                    <WrapPanel x:Name="GamesDriveOptions" Margin="0,0,0,4" />
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Use Default" Width="180" Height="50" Margin="0,0,10,8" Click="GamesUseDefault_Click" />
                        <Button Content="Browse…" Width="180" Height="50" Margin="0,0,10,8" Click="GamesCustom_Click" />
                        <Button Content="+ Add Another Games Location" MinWidth="260" Height="50" Margin="0,0,10,8" Click="GamesAddLocation_Click" />
                    </WrapPanel>

                    <TextBlock x:Name="AdditionalGamesHeading"
                               Text="ADDITIONAL GAMES LOCATIONS"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Visibility="Collapsed"
                               Margin="0,0,0,8" />
                    <StackPanel x:Name="AdditionalGamesRootsPanel" Margin="0,0,0,24" />

                    <TextBlock Text="BIOS FOLDER" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Shared emulator BIOS / firmware location." Margin="0,2,0,8" Foreground="{StaticResource MutedBrush}" />
                    <TextBox x:Name="BiosPathText"
                             Height="52"
                             Padding="14,8"
                             FontSize="17"
                             IsReadOnly="True"
                             IsTabStop="False"
                             Margin="0,0,0,10" />
                    <WrapPanel x:Name="BiosDriveOptions" Margin="0,0,0,4" />
                    <WrapPanel Margin="0,0,0,30">
                        <Button Content="Use Default" Width="180" Height="50" Margin="0,0,10,8" Click="BiosUseDefault_Click" />
                        <Button Content="Browse…" Width="180" Height="50" Margin="0,0,10,8" Click="BiosCustom_Click" />
                    </WrapPanel>

                    <TextBlock Text="EXISTING GAMES" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Grev Home can open Scan Directory at your primary Games folder after the first account signs in. Your other configured Games locations are also shown as quick locations inside Scan Directory."
                               Margin="0,2,0,8"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                    <Button x:Name="ScanChoiceButton"
                            Content="✓  Scan my primary Games folder after I create my account"
                            MinWidth="520"
                            Height="50"
                            Margin="0,0,0,30"
                            HorizontalAlignment="Left"
                            Click="ToggleScanChoice_Click" />

                    <TextBlock x:Name="StatusText"
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Continue" Width="220" Height="56" Margin="6" Click="Continue_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <local:FolderPickerView x:Name="FolderPicker" Panel.ZIndex="100" />
    </Grid>
</UserControl>
