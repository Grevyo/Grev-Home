<UserControl x:Class="GrevHome.Views.InstalledLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="72,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Installed" FontSize="40" FontWeight="SemiBold" />
                <TextBlock x:Name="ContextText"
                           Margin="0,6,0,0"
                           FontSize="15"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Button Content="Back"
                    Width="130"
                    Height="48"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="Back_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
            <Button x:Name="AllFilterButton" Tag="All" Content="All" Width="105" Height="44" Margin="0,0,8,0" Click="Filter_Click" />
            <Button Tag="Application" Content="Apps" Width="105" Height="44" Margin="0,0,8,0" Click="Filter_Click" />
            <Button Tag="Emulator" Content="Emulators" Width="130" Height="44" Margin="0,0,8,0" Click="Filter_Click" />
            <Button Tag="Utility" Content="Tools" Width="105" Height="44" Click="Filter_Click" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="EmptyText"
                           Text="Nothing is installed yet. Install supported packages from Grev Store."
                           Margin="0,28,0,0"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           Foreground="{StaticResource MutedBrush}" />
                <WrapPanel x:Name="AppsPanel" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Margin="0,18,0,0"
                Padding="18"
                Background="#11151E"
                BorderBrush="#2B3344"
                BorderThickness="1"
                CornerRadius="12">
            <TextBlock x:Name="StatusText"
                       Text="Select an app to open it. Hold A or right-click an app tile for more actions."
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid x:Name="AppActionOverlay"
              Grid.RowSpan="4"
              Panel.ZIndex="50"
              Background="#CC080A0F"
              Visibility="Collapsed">
            <Border Width="430"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#11151E"
                    BorderBrush="#374158"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel>
                    <TextBlock Text="APP ACTIONS"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="AppActionTitleText"
                               Margin="0,6,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AppActionStateText"
                               Margin="0,5,0,18"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />

                    <Button x:Name="AppActionOpenButton"
                            Content="Open"
                            Height="48"
                            Click="AppActionOpen_Click" />
                    <Button x:Name="AppActionSwitchButton"
                            Content="Switch to App"
                            Height="48"
                            Margin="0,7,0,0"
                            Visibility="Collapsed"
                            Click="AppActionSwitch_Click" />
                    <Button x:Name="AppActionSettingsButton"
                            Content="App Settings"
                            Height="48"
                            Margin="0,7,0,0"
                            Click="AppActionSettings_Click" />
                    <Button x:Name="AppActionRestartButton"
                            Content="Restart App"
                            Height="48"
                            Margin="0,7,0,0"
                            Visibility="Collapsed"
                            Click="AppActionRestart_Click" />
                    <Button x:Name="AppActionCloseButton"
                            Content="Close App"
                            Height="48"
                            Margin="0,7,0,0"
                            Visibility="Collapsed"
                            Click="AppActionClose_Click" />
                    <Button x:Name="AppActionForceKillButton"
                            Content="Force Kill App"
                            Height="48"
                            Margin="0,7,0,0"
                            Visibility="Collapsed"
                            Click="AppActionForceKill_Click" />
                    <Button x:Name="AppActionRunningAppsButton"
                            Content="Running Apps"
                            Height="48"
                            Margin="0,7,0,0"
                            Visibility="Collapsed"
                            Click="AppActionRunningApps_Click" />
                    <Button x:Name="AppActionStoreButton"
                            Content="View in Grev Store"
                            Height="48"
                            Margin="0,7,0,0"
                            Click="AppActionStore_Click" />
                    <Button x:Name="AppActionCancelButton"
                            Content="Cancel"
                            Height="48"
                            Margin="0,14,0,0"
                            Click="AppActionCancel_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
