<UserControl x:Class="GrevHome.Views.InstalledLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="InstalledActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="72,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Installed" FontSize="40" FontWeight="SemiBold" />
                <TextBlock x:Name="ContextText"
                           Margin="0,6,0,0"
                           FontSize="15"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Content="Back"
                    Width="130"
                    MinHeight="48"
                    Height="Auto"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="Back_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
            <Button x:Name="AllFilterButton" Tag="All" Content="All" Width="105" MinHeight="44" Height="Auto" Margin="0,0,8,0" Click="Filter_Click" />
            <Button Tag="Application" Content="Apps" Width="105" MinHeight="44" Height="Auto" Margin="0,0,8,0" Click="Filter_Click" />
            <Button Tag="Emulator" Content="Emulators" Width="130" MinHeight="44" Height="Auto" Margin="0,0,8,0" Click="Filter_Click" />
            <Button Tag="Utility" Content="Tools" Width="105" MinHeight="44" Height="Auto" Click="Filter_Click" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="EmptyText"
                           Text="Nothing is installed yet. Install supported packages from Grev Store."
                           Margin="0,28,0,0"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <WrapPanel x:Name="AppsPanel" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Margin="0,18,0,0"
                Padding="18"
                Background="#11151E"
                BorderBrush="#2B3344"
                BorderThickness="1"
                CornerRadius="12">
            <TextBlock x:Name="StatusText"
                       Text="Select an app to open it. Hold A or right-click an app tile for more actions."
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid x:Name="AppActionOverlay"
              Grid.RowSpan="4"
              Panel.ZIndex="50"
              Background="#CC080A0F"
              Visibility="Collapsed">
            <Border Width="520"
                    MaxHeight="780"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#11151E"
                    BorderBrush="#374158"
                    BorderThickness="1"
                    CornerRadius="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="APP ACTIONS"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="AppActionTitleText"
                                   Margin="0,6,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="AppActionStateText"
                                   Margin="0,5,0,18"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />

                        <Button x:Name="AppActionOpenButton"
                                Content="Open"
                                Style="{StaticResource InstalledActionButtonStyle}"
                                Click="AppActionOpen_Click" />
                        <Button x:Name="AppActionSwitchButton"
                                Content="Switch to App"
                                Margin="0,7,0,0"
                                Visibility="Collapsed"
                                Style="{StaticResource InstalledActionButtonStyle}"
                                Click="AppActionSwitch_Click" />
                        <Button x:Name="AppActionSettingsButton"
                                Content="App Settings"
                                Margin="0,7,0,0"
                                Style="{StaticResource InstalledActionButtonStyle}"
                                Click="AppActionSettings_Click" />
                        <Button x:Name="AppActionRestartButton"
                                Content="Restart App"
                                Margin="0,7,0,0"
                                Visibility="Collapsed"
                                Style="{StaticResource InstalledActionButtonStyle}"
                                Click="AppActionRestart_Click" />
                        <Button x:Name="AppActionCloseButton"
                                Content="Close App"
                                Margin="0,7,0,0"
                                Visibility="Collapsed"
                                Style="{StaticResource InstalledActionButtonStyle}"
                                Click="AppActionClose_Click" />
                        <Button x:Name="AppActionForceKillButton"
                                Content="Force Kill App"
                                Margin="0,7,0,0"
                                Visibility="Collapsed"
                                Style="{StaticResource InstalledActionButtonStyle}"
                                Click="AppActionForceKill_Click" />
                        <Button x:Name="AppActionAppKillerButton"
                                Content="App Killer"
                                Margin="0,7,0,0"
                                Visibility="Collapsed"
                                Style="{StaticResource InstalledActionButtonStyle}"
                                Click="AppActionAppKiller_Click" />
                        <Button x:Name="AppActionRunningAppsButton"
                                Content="Running Apps"
                                Margin="0,7,0,0"
                                Visibility="Collapsed"
                                Style="{StaticResource InstalledActionButtonStyle}"
                                Click="AppActionRunningApps_Click" />
                        <Button x:Name="AppActionStoreButton"
                                Content="View in Grev Store"
                                Margin="0,7,0,0"
                                Style="{StaticResource InstalledActionButtonStyle}"
                                Click="AppActionStore_Click" />
                        <Button x:Name="AppActionCancelButton"
                                Content="Cancel"
                                Margin="0,14,0,0"
                                Style="{StaticResource InstalledActionButtonStyle}"
                                Click="AppActionCancel_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
