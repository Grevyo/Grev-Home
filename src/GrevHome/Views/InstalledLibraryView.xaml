<UserControl x:Class="GrevHome.Views.InstalledLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="72,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Installed" FontSize="40" FontWeight="SemiBold" />
                <TextBlock x:Name="ContextText"
                           Margin="0,6,0,0"
                           FontSize="15"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Button Content="Back"
                    Width="130"
                    Height="48"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="Back_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
            <Button x:Name="AllFilterButton" Tag="All" Content="All" Width="105" Height="44" Margin="0,0,8,0" Click="Filter_Click" />
            <Button Tag="Application" Content="Apps" Width="105" Height="44" Margin="0,0,8,0" Click="Filter_Click" />
            <Button Tag="Emulator" Content="Emulators" Width="130" Height="44" Margin="0,0,8,0" Click="Filter_Click" />
            <Button Tag="Utility" Content="Tools" Width="105" Height="44" Click="Filter_Click" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="EmptyText"
                           Text="Nothing is installed yet. Grev Store and package installation come later."
                           Margin="0,28,0,0"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           Foreground="{StaticResource MutedBrush}" />
                <WrapPanel x:Name="AppsPanel" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Margin="0,18,0,0"
                Padding="18"
                Background="#11151E"
                BorderBrush="#2B3344"
                BorderThickness="1"
                CornerRadius="12">
            <TextBlock x:Name="StatusText"
                       Text="0.3 reads installed app manifests from Global Apps and the current GrevID's Apps folder."
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
