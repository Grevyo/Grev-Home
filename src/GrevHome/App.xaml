<Application x:Class="GrevHome.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#151923" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#20283A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7EA6FF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#97A0B3" />
        <SolidColorBrush x:Key="AdminRoleBrush" Color="#D8B65A" />
        <SolidColorBrush x:Key="StandardRoleBrush" Color="#D94B55" />
        <SolidColorBrush x:Key="GuestRoleBrush" Color="#747B88" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#343D51" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42" />
                </Trigger>
                <Trigger Property="Content" Value="Back">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Content" Value="Back to Dashboard">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SharpTileButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Milestone 0.15 shell-modal primitives. Content regions may scroll independently, but
             action rows should remain outside those ScrollViewers so controller focus cannot drag
             explanatory content away from its start. -->
        <Style x:Key="ShellModalCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="28" />
            <Setter Property="Background" Value="#11151E" />
            <Setter Property="BorderBrush" Value="#3A465F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ShellModalActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShellModalDangerActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ShellModalActionButtonStyle}">
            <Setter Property="BorderBrush" Value="#A84F59" />
        </Style>

        <Style x:Key="ShellModalEyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
    </Application.Resources>
</Application>
